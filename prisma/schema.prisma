generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_extension_histories {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(100)
  type       Int       @default(1) @db.TinyInt
  version    String    @default("0") @db.VarChar(20)
  detail     String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@index([name], map: "admin_extension_histories_name_index")
}

model admin_extensions {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  name       String    @unique(map: "admin_extensions_name_unique") @db.VarChar(100)
  version    String    @default("") @db.VarChar(20)
  is_enabled Int       @default(0) @db.TinyInt
  options    String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model admin_menu {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  parent_id  BigInt    @default(0)
