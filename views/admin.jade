    script.
      const { useState, useEffect, useMemo, useCallback } = React;
      const { createRoot } = ReactDOM;
      const {
        Box,
        CssBaseline,
        AppBar,
        Toolbar,
        Typography,
        Drawer,
        List,
        ListItemButton,
        ListItemText,
        Collapse,
        IconButton,
        Divider,
        Button,
        Avatar,
        Paper,
        Icon,
        Stack,
        Chip,
        Table,
        TableBody,
        TableCell,
        TableContainer,
        TableHead,
        TableRow,
        TextField,
        Dialog,
        DialogTitle,
        DialogContent,
        DialogActions,
        FormControlLabel,
        Switch,
        Snackbar,
        Alert,
        CircularProgress,
        LinearProgress,
        Tooltip,
        MenuItem,
        Pagination,
        Checkbox
      } = MaterialUI;
      const ExpandLess = (props) => React.createElement(Icon, props, 'expand_less');
      const ExpandMore = (props) => React.createElement(Icon, props, 'expand_more');
      const MenuIcon = (props) => React.createElement(Icon, props, 'menu');
      const LogoutIcon = (props) => React.createElement(Icon, props, 'logout');

      const drawerWidth = 260;
      const collapsedWidth = 72;
      const MODULE_ADMIN_CODES = ['FrmModuleAdmin'];
      const STAFF_ADMIN_CODES = ['FrmStaffAdmin'];
      const USER_ADMIN_CODES = ['FrmUserAdmin'];
      const ORGANIZE_ADMIN_CODES = ['FrmOrganizeAdmin'];
      const ROLE_ADMIN_CODES = ['FrmRoleAdmin'];
      const POST_ADMIN_CODES = ['FrmPostAdmin'];
      const USER_PERMISSION_ADMIN_CODES = ['FrmUserPermissionAdmin'];
      const PERMISSION_ITEM_ADMIN_CODES = ['FrmPermissionItemAdmin'];
      const ROLE_PERMISSION_ADMIN_CODES = ['FrmRolePermissionAdmin'];
      const SEQUENCE_ADMIN_CODES = ['SequenceAdmin'];
      const TABLE_FIELD_ADMIN_CODES = ['FrmTableFieldAdmin'];
      const SYS_CONFIG_ADMIN_CODES = ['FrmSysConfig'];
      const PARAMETER_ADMIN_CODES = ['ParameterAdmin', 'FrmParameterAdmin'];
      const LOG_ADMIN_CODES = ['FrmLogAdmin'];
      const EXCEPTION_ADMIN_CODES = ['FrmExceptionAdmin'];
      const DATA_ITEM_ADMIN_CODES = ['FrmDataDictionaryAdmin'];
      const MESSAGE_ADMIN_CODES = ['MessageManagement'];

      const matchNavUrl = (node = {}, urls = []) => {
        const url = (
          node.code ||
          ''
        );
        return urls.some((candidate) => url.includes(candidate));
      };

      const isModuleAdminNode = (node = {}) => matchNavUrl(node, MODULE_ADMIN_CODES);

      const isStaffAdminNode = (node = {}) => matchNavUrl(node, STAFF_ADMIN_CODES);

      const isUserAdminNode = (node = {}) => matchNavUrl(node, USER_ADMIN_CODES);

      const isOrganizeAdminNode = (node = {}) => matchNavUrl(node, ORGANIZE_ADMIN_CODES);

      const isRoleAdminNode = (node = {}) => matchNavUrl(node, ROLE_ADMIN_CODES);

      const isPostAdminNode = (node = {}) => matchNavUrl(node, POST_ADMIN_CODES);

      const isUserPermissionAdminNode = (node = {}) => matchNavUrl(node, USER_PERMISSION_ADMIN_CODES);

      const isPermissionItemAdminNode = (node = {}) => matchNavUrl(node, PERMISSION_ITEM_ADMIN_CODES);

      const isRolePermissionAdminNode = (node = {}) => matchNavUrl(node, ROLE_PERMISSION_ADMIN_CODES);

      const isSequenceAdminNode = (node = {}) => matchNavUrl(node, SEQUENCE_ADMIN_CODES);

      const isTableFieldAdminNode = (node = {}) => matchNavUrl(node, TABLE_FIELD_ADMIN_CODES);

      const isSysConfigAdminNode = (node = {}) => matchNavUrl(node, SYS_CONFIG_ADMIN_CODES);

      const isParameterAdminNode = (node = {}) => matchNavUrl(node, PARAMETER_ADMIN_CODES);

      const isLogAdminNode = (node = {}) => matchNavUrl(node, LOG_ADMIN_CODES);

      const isExceptionAdminNode = (node = {}) => matchNavUrl(node, EXCEPTION_ADMIN_CODES);

      const isDataItemAdminNode = (node = {}) => matchNavUrl(node, DATA_ITEM_ADMIN_CODES);

      const isMessageAdminNode = (node = {}) => matchNavUrl(node, MESSAGE_ADMIN_CODES);

      const NavItem = ({ node, onSelect, activeNodeId, depth = 0 }) => {
        const hasChildren = node.children && node.children.length > 0;
        const [open, setOpen] = useState(false);
        const handleClick = () => {
          if (hasChildren) {
            setOpen((prev) => !prev);
          }
          onSelect?.(node);
        };
        return React.createElement(React.Fragment, null,
          React.createElement(ListItemButton, {
            onClick: handleClick,
            selected: activeNodeId === node.id,
            sx: {
              borderRadius: 2,
              my: 0.25,
              pl: 2 + depth * 1.5,
              color: '#1f2937',
              '&.Mui-selected': { backgroundColor: 'rgba(99,102,241,0.15)', color: '#312e81' }
            }
          },
          React.createElement(ListItemText, { primary: node.title || node.code }),
          ),
          hasChildren ? React.createElement(Collapse, { in: open, timeout: 'auto', unmountOnExit: true },
            React.createElement(NavigationTree, {
              nodes: node.children,
              onSelect,
              activeNodeId,
              depth: depth + 1
            })
          ) : null
        );
      };

      const NavigationTree = ({ nodes = [], onSelect, activeNodeId, depth = 0 }) => {
        if (!nodes || !nodes.length) {
          return React.createElement(Typography, {
            variant: 'body2',
            color: 'text.secondary',
            sx: { px: 1 }
          }, '暂无导航');
        }
        return React.createElement(List, { component: 'nav', disablePadding: depth > 0 },
          nodes.map((node) =>
            React.createElement(NavItem, {
              key: node.id,
              node,
              onSelect,
              activeNodeId,
              depth
            })
          )
        );
      };

      const DashboardOverview = ({ user, activeNode }) => {
        const cards = [
          { title: '今日登录', value: '128', trend: '+12.5%' },
          { title: '活跃模块', value: '42', trend: '+3' },
          { title: '待办事项', value: '7', trend: '-2' }
        ];
        return React.createElement(Stack, { spacing: 3 },
          React.createElement(Box, {
            sx: {
              display: 'grid',
              gap: 2,
              gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))'
            }
          },
          cards.map((card) =>
            React.createElement(Paper, {
              key: card.title,
              sx: {
                p: 3,
                borderRadius: 3,
                background: 'linear-gradient(135deg,#eef2ff,#dbeafe)'
              }
            },
            React.createElement(Typography, { variant: 'overline', color: 'primary.main' }, card.title),
            React.createElement(Typography, { variant: 'h4', mt: 1, color: '#1f2937' }, card.value),
            React.createElement(Typography, { variant: 'body2', color: 'text.secondary' }, '环比 ' + card.trend)
            )
          )
          ),
          React.createElement(Paper, { sx: { p: 3, borderRadius: 3 } },
            React.createElement(Typography, { variant: 'h5', mb: 1 }, '欢迎回来，' + (user.RealName || '管理员')),
            React.createElement(Typography, { variant: 'body1', color: 'text.secondary' },
              activeNode
                ? '当前聚焦于【' + (activeNode.title || activeNode.code) + '】，可在左侧导航切换其他模块。'
                : '使用左侧导航探索各功能模块，可随时切换到模块管理进行维护。'
            )
          )
        );
      };

      const buildModuleHierarchy = (items = []) => {
        const lookup = new Map();
        items.forEach((item) => {
          lookup.set(item.id, { ...item, children: [] });
        });
        const roots = [];
        lookup.forEach((node) => {
          if (node.parentId && lookup.has(node.parentId)) {
            lookup.get(node.parentId).children.push(node);
          } else {
            roots.push(node);
          }
        });
        const sortFn = (a, b) => (a.sortCode || 0) - (b.sortCode || 0);
        lookup.forEach((node) => node.children.sort(sortFn));
        return roots.sort(sortFn);
      };
      const ModuleTreeNode = ({ node, selectedId, onSelect, depth = 0 }) => {
        const hasChildren = node.children && node.children.length > 0;
        const [open, setOpen] = useState(depth < 1);
        const handleClick = () => {
          onSelect(node.id);
          if (hasChildren) {
            setOpen((prev) => !prev);
          }
        };
        return React.createElement(React.Fragment, null,
          React.createElement(ListItemButton, {
            onClick: handleClick,
            selected: selectedId === node.id,
            sx: {
              pl: 2 + depth * 1.5,
              borderRadius: 1.5,
              mb: 0.25,
              '&.Mui-selected': { backgroundColor: 'rgba(99,102,241,0.15)' }
            }
          },
        React.createElement(ListItemText, {
            primary: node.fullName || node.fullname || node.code,
            secondary: node.code
          }),
          ),
          hasChildren ? React.createElement(Collapse, { in: open, timeout: 'auto', unmountOnExit: true },
            React.createElement(List, { disablePadding: true },
              node.children.map((child) =>
                React.createElement(ModuleTreeNode, {
                  key: child.id,
                  node: child,
                  selectedId,
                  onSelect,
                  depth: depth + 1
                })
              )
            )
          ) : null
        );
      };

      const ModuleTree = ({ data = [], selectedId, onSelect }) => {
        return React.createElement(List, { component: 'nav' },
          React.createElement(ListItemButton, {
            selected: selectedId === null,
            onClick: () => onSelect(null),
            sx: { borderRadius: 1.5, mb: 0.5 }
          },
          React.createElement(ListItemText, { primary: '全部模块' })
          ),
          data.map((node) =>
            React.createElement(ModuleTreeNode, {
              key: node.id,
              node,
              selectedId,
              onSelect,
              depth: 0
            })
          )
        );
      };

      const moduleTypeMap = {
        1: '系统',
        2: '平台',
        3: '应用',
        4: '窗体',
        5: '报表',
        6: '菜单'
      };

      const createDefaultForm = (parentId = '') => ({
        id: '',
        parentId: parentId || '',
        code: '',
        fullName: '',
        category: '',
        moduleType: 6,
        navigateUrl: '',
        mvcNavigateUrl: '',
        iconCss: '',
        iconUrl: '',
        description: '',
        sortCode: '',
        enabled: true,
        isPublic: false,
        isMenu: true,
        allowEdit: true,
        allowDelete: true,
        expand: false
      });

      const mapRecordToFormValues = (record) =>
        record
          ? {
              id: record.id,
              parentId: record.parentId || '',
              code: record.code || '',
              fullName: record.fullName || '',
              category: record.category || '',
              moduleType: record.moduleType || 6,
              navigateUrl: record.navigateUrl || '',
              mvcNavigateUrl: record.mvcNavigateUrl || '',
              iconCss: record.iconCss || '',
              iconUrl: record.iconUrl || '',
              description: record.description || '',
              sortCode: record.sortCode ?? '',
              enabled: !!record.enabled,
              isPublic: !!record.isPublic,
              isMenu: !!record.isMenu,
              allowEdit: !!record.allowEdit,
              allowDelete: !!record.allowDelete,
              expand: !!record.expand
            }
          : createDefaultForm();

      const serializeFormValues = (values) => ({
        parentId: values.parentId || null,
        code: values.code?.trim(),
        fullName: values.fullName?.trim(),
        category: values.category?.trim() || null,
        moduleType: Number(values.moduleType) || 6,
        navigateUrl: values.navigateUrl || '#',
        mvcNavigateUrl: values.mvcNavigateUrl || '#',
        iconCss: values.iconCss || null,
        iconUrl: values.iconUrl || null,
        description: values.description || null,
        sortCode: values.sortCode === '' ? null : Number(values.sortCode),
        enabled: !!values.enabled,
        isPublic: !!values.isPublic,
        isMenu: !!values.isMenu,
        allowEdit: !!values.allowEdit,
        allowDelete: !!values.allowDelete,
        expand: !!values.expand
      });
      const AdminApp = () => {
        const data = window.__APP_DATA__ || {};
        const user = data.user || {};
        const navTree = data.nav || [];
        const [mobileOpen, setMobileOpen] = useState(false);
        const [collapsed, setCollapsed] = useState(false);
        const [activeView, setActiveView] = useState({ type: 'dashboard', node: null });
        const [activeNavId, setActiveNavId] = useState(null);

        const toggleDrawer = () => setMobileOpen((prev) => !prev);
        const toggleCollapse = () => setCollapsed((prev) => !prev);
        const navWidth = collapsed ? collapsedWidth : drawerWidth;

        const handleNavSelect = (node) => {
          if (!node) return;
          setActiveNavId(node.id);
          if (isModuleAdminNode(node)) {
            setActiveView({ type: 'module-admin', node });
          } else if (isStaffAdminNode(node)) {
            setActiveView({ type: 'staff-admin', node });
          } else if (isOrganizeAdminNode(node)) {
            setActiveView({ type: 'organize-admin', node });
          } else if (isUserAdminNode(node)) {
            setActiveView({ type: 'user-admin', node });
          } else if (isSequenceAdminNode(node)) {
            setActiveView({ type: 'sequence-admin', node });
          } else if (isTableFieldAdminNode(node)) {
            setActiveView({ type: 'table-field-admin', node });
          } else if (isSysConfigAdminNode(node)) {
            setActiveView({ type: 'sys-config-admin', node });
          } else if (isParameterAdminNode(node)) {
            setActiveView({ type: 'parameter-admin', node });
          } else if (isLogAdminNode(node)) {
            setActiveView({ type: 'log-admin', node });
          } else if (isExceptionAdminNode(node)) {
            setActiveView({ type: 'exception-admin', node });
          } else if (isDataItemAdminNode(node)) {
            setActiveView({ type: 'data-item-admin', node });
          } else if (isMessageAdminNode(node)) {
            setActiveView({ type: 'message-admin', node });
          } else if (isRolePermissionAdminNode(node)) {
            setActiveView({ type: 'role-permission-admin', node });
          } else if (isRoleAdminNode(node)) {
            setActiveView({ type: 'role-admin', node });
          } else if (isPostAdminNode(node)) {
            setActiveView({ type: 'post-admin', node });
          } else if (isUserPermissionAdminNode(node)) {
            setActiveView({ type: 'user-permission-admin', node });
          } else if (isPermissionItemAdminNode(node)) {
            setActiveView({ type: 'permission-item-admin', node });
          } else {
            setActiveView({ type: 'dashboard', node });
          }
          if (mobileOpen) {
            setMobileOpen(false);
          }
        };

        const handleLogout = async () => {
          try {
            const response = await fetch('/login/logout', { method: 'POST' });
            const result = await response.json();
            if (result?.redirect) {
              window.location.href = result.redirect;
            }
          } catch (error) {
            console.error(error);
          }
        };

        const renderContent = () => {
          if (activeView.type === 'module-admin') {
            return React.createElement(ModuleAdminPage, null);
          }
          if (activeView.type === 'staff-admin') {
            return React.createElement(StaffAdminPage, null);
          }
          if (activeView.type === 'user-admin') {
            return React.createElement(UserAdminPage, null);
          }
          if (activeView.type === 'organize-admin') {
            return React.createElement(OrganizeAdminPage, null);
          }
          if (activeView.type === 'role-admin') {
            return React.createElement(RoleAdminPage, null);
          }
          if (activeView.type === 'post-admin') {
            return React.createElement(PostAdminPage, null);
          }
          if (activeView.type === 'user-permission-admin') {
            return React.createElement(UserPermissionAdminPage, null);
          }
          if (activeView.type === 'permission-item-admin') {
            return React.createElement(PermissionItemAdminPage, null);
          }
          if (activeView.type === 'sequence-admin') {
            return React.createElement(SequenceAdminPage, null);
          }
          if (activeView.type === 'table-field-admin') {
            return React.createElement(TableFieldAdminPage, null);
          }
          if (activeView.type === 'sys-config-admin') {
            return React.createElement(SysConfigAdminPage, null);
          }
          if (activeView.type === 'parameter-admin') {
            return React.createElement(ParameterAdminPage, null);
          }
          if (activeView.type === 'log-admin') {
            return React.createElement(LogAdminPage, null);
          }
          if (activeView.type === 'exception-admin') {
            return React.createElement(ExceptionAdminPage, null);
          }
          if (activeView.type === 'data-item-admin') {
            return React.createElement(DataItemAdminPage, null);
          }
          if (activeView.type === 'message-admin') {
            return React.createElement(MessageAdminPage, null);
          }
          if (activeView.type === 'role-permission-admin') {
            return React.createElement(RolePermissionAdminPage, null);
          }
          return React.createElement(DashboardOverview, { user, activeNode: activeView.node });
        };

        const drawer = React.createElement(Box, {
          sx: {
            p: 2,
            height: '100%',
            display: 'flex',
            flexDirection: 'column',
            gap: 1
          }
        },
          React.createElement(Box, {
            sx: {
              display: 'flex',
              alignItems: 'center',
              justifyContent: collapsed ? 'center' : 'space-between'
            }
          },
            !collapsed ? React.createElement(Typography, { variant: 'h6', fontWeight: 600 }, '功能导航') : null,
            React.createElement(Tooltip, { title: collapsed ? '展开导航' : '折叠导航' },
              React.createElement(IconButton, { size: 'small', onClick: toggleCollapse },
                React.createElement(MenuIcon, null)
              )
            )
          ),
          !collapsed
            ? React.createElement(Box, { sx: { flexGrow: 1, overflowY: 'auto', mt: 1 } },
                React.createElement(NavigationTree, {
                  nodes: navTree,
                  onSelect: handleNavSelect,
                  activeNodeId: activeNavId
                })
              )
            : React.createElement(Box, { sx: { flexGrow: 1 } })
        );

        return React.createElement(Box, { sx: { display: 'flex', minHeight: '100vh', backgroundColor: '#f4f6f8' } },
          React.createElement(CssBaseline, null),
          React.createElement(AppBar, {
            position: 'fixed',
            color: 'default',
            sx: {
              width: { sm: `calc(100% - ${navWidth}px)` },
              ml: { sm: `${navWidth}px` },
              backgroundColor: '#ffffff',
              boxShadow: '0 1px 3px rgba(15, 23, 42, 0.1)'
            }
          },
          React.createElement(Toolbar, null,
            React.createElement(IconButton, {
              color: 'inherit',
              edge: 'start',
              onClick: toggleDrawer,
              sx: { mr: 2, display: { sm: 'none' } }
            }, React.createElement(MenuIcon, null)),
            React.createElement(Typography, {
              variant: 'h6',
              noWrap: true,
              sx: { flexGrow: 1, color: '#1f2933' }
            }, activeView.type === 'module-admin'
              ? '模块管理'
              : activeView.type === 'staff-admin'
              ? '员工管理'
              : activeView.type === 'user-admin'
              ? '用户管理'
              : activeView.type === 'organize-admin'
              ? '组织机构管理'
              : activeView.type === 'role-admin'
              ? '角色管理'
              : activeView.type === 'post-admin'
              ? '岗位管理'
              : activeView.type === 'user-permission-admin'
              ? '用户权限管理'
              : activeView.type === 'permission-item-admin'
              ? '权限项管理'
              : activeView.type === 'sequence-admin'
              ? '序列管理'
              : activeView.type === 'table-field-admin'
              ? '表字段管理'
              : activeView.type === 'sys-config-admin'
              ? '系统配置管理'
              : activeView.type === 'parameter-admin'
              ? '系统参数管理'
              : activeView.type === 'log-admin'
              ? '系统日志管理'
              : activeView.type === 'exception-admin'
              ? '系统异常管理'
              : activeView.type === 'data-item-admin'
              ? '数据字典管理'
              : activeView.type === 'message-admin'
              ? '系统消息管理'
              : activeView.type === 'role-permission-admin'
              ? '角色权限管理'
              : '管理驾驶舱'),
            React.createElement(Box, { sx: { display: 'flex', alignItems: 'center', gap: 2 } },
              React.createElement(Box, null,
                React.createElement(Typography, { variant: 'subtitle1', textAlign: 'right', color: '#1f2933' }, user.RealName || '管理员'),
                React.createElement(Typography, { variant: 'caption', color: 'rgba(31,41,51,0.6)' }, user.UserName || '')
              ),
              React.createElement(Avatar, { sx: { bgcolor: '#6366f1', color: '#fff' } }, (user.RealName || 'Admin').slice(0, 1)),
              React.createElement(Button, {
                color: 'primary',
                variant: 'outlined',
                startIcon: React.createElement(LogoutIcon, null),
                onClick: handleLogout
              }, '退出')
            )
          )
          ),
          React.createElement(Box, {
            component: 'nav',
            sx: { width: { sm: navWidth }, flexShrink: { sm: 0 } }
          },
          React.createElement(Drawer, {
            variant: 'temporary',
            open: mobileOpen,
            onClose: toggleDrawer,
            ModalProps: { keepMounted: true },
            sx: {
              display: { xs: 'block', sm: 'none' },
              '& .MuiDrawer-paper': { boxSizing: 'border-box', width: drawerWidth }
            }
          }, drawer),
          React.createElement(Drawer, {
            variant: 'permanent',
            sx: {
              display: { xs: 'none', sm: 'block' },
              '& .MuiDrawer-paper': {
                boxSizing: 'border-box',
                width: navWidth,
                borderRight: '1px solid rgba(0,0,0,0.08)',
                backgroundColor: '#fff',
                color: '#1f2933'
              }
            },
            open: true
          }, drawer)
          ),
          React.createElement(Box, {
            component: 'main',
            sx: {
              flexGrow: 1,
              p: { xs: 2, md: 3 },
              width: { sm: `calc(100% - ${navWidth}px)` },
              mt: 8
            }
          }, renderContent())
        );
      };

      const root = createRoot(document.getElementById('root'));
      root.render(React.createElement(AdminApp));







