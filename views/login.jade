doctype html
html(lang="zh-CN")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title || '后台登录'
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="")
    link(href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Noto+Sans+SC:wght@400;500&display=swap" rel="stylesheet")
    style.
      html, body { height: 100%; margin: 0; font-family: 'Roboto','Noto Sans SC',sans-serif; background: linear-gradient(135deg,#f6f8ff,#eef2ff); }
      #root { width: 100%; height: 100%; }
  body
    div#root
    script.
      window.__SAAS_MODE__ = !{JSON.stringify(!!saasMode)};
    script(src="/vendor/react.js")
    script(src="/vendor/react-dom.js")
    script(src="/vendor/material-ui.js")
    script(src="/vendor/emotion-react.js")
    script(src="/vendor/emotion-styled.js")
    script.
      const { useState, useMemo } = React;
      const { createRoot } = ReactDOM;
      const {
        ThemeProvider,
        createTheme,
        CssBaseline,
        Box,
        Paper,
        Typography,
        TextField,
        Button,
        Stack,
        Alert,
        CircularProgress,
        Divider,
        Tabs,
        Tab,
        InputAdornment,
        IconButton,
        Dialog,
        DialogTitle,
        DialogContent,
        DialogActions
      } = MaterialUI;

      const loginTheme = createTheme({
        palette: {
          mode: 'light',
          primary: { main: '#3040d6' },
          secondary: { main: '#7c3aed' },
          background: { default: '#eef1f8' }
        },
        typography: {
          fontFamily: "'Roboto','Noto Sans SC',sans-serif"
        },
        shape: { borderRadius: 18 }
      });

      const FeatureItem = ({ title, description }) => (
        React.createElement(Box, {
          sx: {
            borderRadius: 3,
            border: '1px solid rgba(255,255,255,0.35)',
            p: 2,
            bgcolor: 'rgba(255,255,255,0.08)',
            backdropFilter: 'blur(6px)'
          }
        },
          React.createElement(Typography, { variant: 'subtitle1', fontWeight: 600, sx: { color: '#fff' } }, title),
          React.createElement(Typography, { variant: 'body2', sx: { color: 'rgba(255,255,255,0.75)', mt: 0.5 } }, description)
        )
      );

      const LoginApp = () => {
        const [mode, setMode] = useState('login');
        const [account, setAccount] = useState('');
        const [password, setPassword] = useState('');
        const [need2fa, setNeed2fa] = useState(false);
        const [tempToken, setTempToken] = useState('');
        const [totpCode, setTotpCode] = useState('');
        const [recoveryCode, setRecoveryCode] = useState('');

        const [regUsername, setRegUsername] = useState('');
        const [regEmail, setRegEmail] = useState('');
        const [regPassword, setRegPassword] = useState('');
        const [regConfirm, setRegConfirm] = useState('');

        const [setupSecret, setSetupSecret] = useState('');
        const [setupQr, setSetupQr] = useState('');
        const [setupCode, setSetupCode] = useState('');
        const [recoveryCodes, setRecoveryCodes] = useState([]);
        const [twoFaDialogOpen, setTwoFaDialogOpen] = useState(false);
        const [redirectAfter2fa, setRedirectAfter2fa] = useState('');

        const [error, setError] = useState('');
        const [info, setInfo] = useState('');
        const [loading, setLoading] = useState(false);
        const [showPassword, setShowPassword] = useState(false);
        const [showRegPassword, setShowRegPassword] = useState(false);

        const resetMessages = () => { setError(''); setInfo(''); };

        const doFetch = async (url, payload, opts = {}) => {
          const resp = await fetch(url, {
            method: opts.method || 'POST',
            headers: { 'Content-Type': 'application/json', ...(opts.headers || {}) },
            body: payload ? JSON.stringify(payload) : undefined
          });
          const data = await resp.json().catch(() => ({}));
          if (!resp.ok || data.success === false) {
            throw new Error(data.message || '操作失败');
          }
          return data;
        };

        const handleLogin = async (event) => {
          event?.preventDefault();
          resetMessages();
          if (!account || !password) {
            setError('请输入账户和密码');
            return;
          }
          setLoading(true);
          try {
            const result = await doFetch('/auth/login', { account, password });
            if (result.need2fa) {
              setNeed2fa(true);
              setTempToken(result.tempToken);
              setInfo('已验证身份，请输入 2FA 验证码');
            } else if (result.needSetup2fa) {
              setInfo('登录成功，建议立即绑定 2FA');
              setRedirectAfter2fa(result.redirect || '/admin');
              setTwoFaDialogOpen(true);
              await handleSetup2fa();
            } else if (result.redirect) {
              window.location.href = result.redirect;
            } else {
              setInfo('登录成功');
            }
          } catch (err) {
            setError(err.message || '登录失败');
          } finally {
            setLoading(false);
          }
        };

        const handleVerify2fa = async () => {
          resetMessages();
          if (!tempToken || (!totpCode && !recoveryCode)) {
            setError('请输入验证码或恢复码');
            return;
          }
          setLoading(true);
          try {
            const result = await doFetch('/auth/2fa/verify', { tempToken, code: totpCode, recoveryCode });
            if (result.redirect) {
              window.location.href = result.redirect;
            } else {
              setInfo('验证成功');
            }
          } catch (err) {
            setError(err.message || '2FA 验证失败');
          } finally {
            setLoading(false);
          }
        };

        const handleRegister = async (event) => {
          event?.preventDefault();
          resetMessages();
          if (!regUsername || !regEmail || !regPassword) {
            setError('请输入用户名、邮箱和密码');
            return;
          }
          if (regPassword !== regConfirm) {
            setError('两次输入的密码不一致');
            return;
          }
          setLoading(true);
          try {
            await doFetch('/auth/register', {
              username: regUsername,
              password: regPassword,
              email: regEmail
            });
            setInfo('注册成功，已登录，请完成 2FA 绑定');
            setTwoFaDialogOpen(true);
            await handleSetup2fa();
          } catch (err) {
            setError(err.message || '注册失败');
          } finally {
            setLoading(false);
          }
        };

        const handleSetup2fa = async () => {
          resetMessages();
          setLoading(true);
          try {
            const data = await doFetch('/auth/2fa/setup', null);
            setSetupSecret(data.secret);
            setSetupQr(data.qr);
            setInfo('已生成二维码，请在验证器中扫描');
          } catch (err) {
            setError(err.message || '生成二维码失败');
          } finally {
            setLoading(false);
          }
        };

        const handleEnable2fa = async () => {
          resetMessages();
          if (!setupSecret || !setupCode) {
            setError('请先获取二维码并输入验证码');
            return;
          }
          setLoading(true);
          try {
            const data = await doFetch('/auth/2fa/enable', { code: setupCode, secret: setupSecret });
            setRecoveryCodes(data.recoveryCodes || []);
            setInfo(data.message || '已开启 2FA，请保存恢复码');
            setTwoFaDialogOpen(false);
            if (redirectAfter2fa) {
              window.location.href = redirectAfter2fa;
            } else {
              setMode('login');
            }
          } catch (err) {
            setError(err.message || '开启 2FA 失败');
          } finally {
            setLoading(false);
          }
        };

        const handleClose2faDialog = () => {
          setTwoFaDialogOpen(false);
          if (redirectAfter2fa) {
            window.location.href = redirectAfter2fa;
          } else {
            setMode('login');
          }
        };

        const handleForgot = async () => {
          resetMessages();
          if (!account && !regEmail) {
            setError('请输入邮箱或账户');
            return;
          }
          setLoading(true);
          try {
            await doFetch('/auth/password/forgot', { email: regEmail || account });
            setInfo('如果邮箱存在，将发送找回邮件（占位，无实发）');
          } catch (err) {
            setError(err.message || '操作失败');
          } finally {
            setLoading(false);
          }
        };

        const tabContent = mode === 'login'
          ? React.createElement(Stack, { spacing: 2, component: 'form', onSubmit: handleLogin },
              React.createElement(TextField, {
                label: '用户名或邮箱',
                value: account,
                onChange: (e) => setAccount(e.target.value),
                autoFocus: true,
                fullWidth: true
              }),
              React.createElement(TextField, {
                label: '密码',
                type: showPassword ? 'text' : 'password',
                value: password,
                onChange: (e) => setPassword(e.target.value),
                fullWidth: true,
                InputProps: {
                  endAdornment: React.createElement(InputAdornment, { position: 'end' },
                    React.createElement(IconButton, { onClick: () => setShowPassword((p) => !p), edge: 'end' },
                      showPassword ? '🙈' : '👁'
                    )
                  )
                }
              }),
              need2fa
                ? React.createElement(Stack, { spacing: 1 },
                    React.createElement(TextField, {
                      label: '2FA 验证码',
                      value: totpCode,
                      onChange: (e) => setTotpCode(e.target.value),
                      fullWidth: true
                    }),
                    React.createElement(TextField, {
                      label: '恢复码（可选）',
                      value: recoveryCode,
                      onChange: (e) => setRecoveryCode(e.target.value),
                      fullWidth: true
                    }),
                    React.createElement(Button, {
                      variant: 'contained',
                      onClick: handleVerify2fa,
                      disabled: loading
                    }, loading ? React.createElement(CircularProgress, { size: 20, color: 'inherit' }) : '提交 2FA')
                  )
                : React.createElement(Button, {
                    type: 'submit',
                    variant: 'contained',
                    disabled: loading
                  }, loading ? React.createElement(CircularProgress, { size: 20, color: 'inherit' }) : '登录'),
              React.createElement(Stack, { direction: 'row', justifyContent: 'space-between', spacing: 1 },
                React.createElement(Button, { variant: 'text', size: 'small', onClick: () => setMode('register') }, '没有账号？去注册'),
                React.createElement(Button, { variant: 'text', size: 'small', onClick: handleForgot }, '忘记密码 / 2FA')
              ),
              (typeof window !== 'undefined' && window.__SAAS_MODE__)
                ? React.createElement(Button, { variant: 'outlined', size: 'small', href: '/saas/register', fullWidth: true }, '申请企业账号')
                : null
            )
          : React.createElement(Stack, { spacing: 2, component: 'form', onSubmit: handleRegister },
              React.createElement(TextField, {
                label: '用户名',
                value: regUsername,
                onChange: (e) => setRegUsername(e.target.value),
                fullWidth: true
              }),
              React.createElement(TextField, {
                label: '邮箱',
                type: 'email',
                value: regEmail,
                onChange: (e) => setRegEmail(e.target.value),
                fullWidth: true
              }),
              React.createElement(TextField, {
                label: '密码',
                type: showRegPassword ? 'text' : 'password',
                value: regPassword,
                onChange: (e) => setRegPassword(e.target.value),
                fullWidth: true,
                InputProps: {
                  endAdornment: React.createElement(InputAdornment, { position: 'end' },
                    React.createElement(IconButton, { onClick: () => setShowRegPassword((p) => !p), edge: 'end' },
                      showRegPassword ? '🙈' : '👁'
                    )
                  )
                }
              }),
              React.createElement(TextField, {
                label: '确认密码',
                type: showRegPassword ? 'text' : 'password',
                value: regConfirm,
                onChange: (e) => setRegConfirm(e.target.value),
                fullWidth: true
              }),
              React.createElement(Button, {
                type: 'submit',
                variant: 'contained',
                disabled: loading
              }, loading ? React.createElement(CircularProgress, { size: 20, color: 'inherit' }) : '注册'),
              React.createElement(Button, { variant: 'text', size: 'small', onClick: () => setMode('login') }, '已有账号？去登录')
            );

        return (
          React.createElement(ThemeProvider, { theme: loginTheme },
            React.createElement(CssBaseline, null),
            React.createElement(Box, {
              sx: {
                minHeight: '100vh',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                px: { xs: 2, md: 4 },
                py: { xs: 4, md: 6 }
              }
            },
              React.createElement(Paper, {
                elevation: 20,
                sx: {
                  width: '100%',
                  maxWidth: 1080,
                  minHeight: { md: 560 },
                  borderRadius: 5,
                  overflow: 'hidden',
                  display: 'flex',
                  flexDirection: { xs: 'column', md: 'row' }
                }
              },
                React.createElement(Box, {
                  sx: {
                    display: { xs: 'none', md: 'flex' },
                    flexDirection: 'column',
                    justifyContent: 'center',
                    flex: '0 0 44%',
                    background: 'linear-gradient(180deg,#4338ca,#312e81)',
                    color: '#fff',
                    p: 4
                  }
                },
                  React.createElement(Box, null,
                    React.createElement(Typography, { variant: 'h5', fontWeight: 700 }, '欢迎使用后台系统'),
                    React.createElement(Typography, { variant: 'body2', sx: { mt: 1.5, mb: 4, color: 'rgba(255,255,255,0.82)' } },
                      '支持账号密码 + 2FA，保障安全登录体验。'
                    ),
                    React.createElement(Stack, { spacing: 1.5 },
                      React.createElement(FeatureItem, { title: '高安全', description: '开启 2FA，多重验证登录。' }),
                      React.createElement(FeatureItem, { title: '统一账号', description: '注册/登录一体化入口。' }),
                      React.createElement(FeatureItem, { title: '找回友好', description: '支持邮箱找回密码/2FA。' })
                    )
                  )
                ),
                React.createElement(Box, {
                  sx: {
                    flex: 1,
                    p: { xs: 3, md: 4 },
                    display: 'flex',
                    flexDirection: 'column',
                    gap: 2
                  }
                },
                  React.createElement(Tabs, {
                    value: mode,
                    onChange: (_, v) => { setMode(v); resetMessages(); },
                    textColor: "primary",
                    indicatorColor: "primary",
                    sx: { mb: 1 }
                  },
                    React.createElement(Tab, { value: 'login', label: '登录' }),
                    React.createElement(Tab, { value: 'register', label: '注册' })
                  ),
                  (error || info) ? React.createElement(Alert, {
                    severity: error ? 'error' : 'success',
                    onClose: () => { setError(''); setInfo(''); }
                  }, error || info) : null,
                  tabContent,
                  React.createElement(Divider, { sx: { my: 1.5 } }),
                  React.createElement(Typography, { variant: 'caption', color: 'text.secondary' },
                    '登录或注册即表示同意系统的安全和使用规范。'
                  )
                )
              )
            ),
            React.createElement(Dialog, { open: twoFaDialogOpen, onClose: handleClose2faDialog, fullWidth: true, maxWidth: 'sm' },
              React.createElement(DialogTitle, null, '绑定 2FA'),
              React.createElement(DialogContent, null,
                React.createElement(Stack, { spacing: 2 },
                  React.createElement(Typography, { variant: 'body2', color: 'text.secondary' }, '使用身份验证器扫描二维码，然后输入 6 位验证码完成绑定。'),
                  setupQr
                    ? React.createElement(Box, { sx: { textAlign: 'center' } },
                        React.createElement('img', { src: setupQr, alt: '2FA QR', style: { width: 180, height: 180 } }),
                        React.createElement(Typography, { variant: 'caption', sx: { wordBreak: 'break-all' } }, setupSecret)
                      )
                    : React.createElement(Button, { onClick: handleSetup2fa, variant: 'outlined', disabled: loading }, '获取二维码'),
                  React.createElement(Stack, { direction: 'row', spacing: 1 },
                    React.createElement(TextField, {
                      label: '验证码',
                      value: setupCode,
                      onChange: (e) => setSetupCode(e.target.value),
                      fullWidth: true
                    }),
                    React.createElement(Button, { variant: 'outlined', onClick: handleSetup2fa, disabled: loading }, '重新生成')
                  ),
                  recoveryCodes && recoveryCodes.length
                    ? React.createElement(Box, { sx: { p: 1.5, borderRadius: 2, bgcolor: 'rgba(244,63,94,0.06)' } },
                        React.createElement(Typography, { variant: 'body2', color: 'error' }, '请保存这些恢复码：'),
                        React.createElement(Stack, { spacing: 0.5 },
                          recoveryCodes.map((c) => React.createElement(Typography, { key: c, variant: 'caption' }, c))
                        )
                      )
                    : null
                )
              ),
              React.createElement(DialogActions, null,
                React.createElement(Button, { onClick: handleClose2faDialog, color: 'inherit' }, '稍后再说'),
                React.createElement(Button, { onClick: handleEnable2fa, variant: 'contained', disabled: loading }, '完成绑定')
              )
            )
          )
        );
      };

      const root = createRoot(document.getElementById('root'));
      root.render(React.createElement(LoginApp));
