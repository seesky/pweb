doctype html
html(lang="zh-CN")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title || '设置密码'
    style.
      :root { --primary:#6366f1; }
      html,body{height:100%;margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;background:linear-gradient(135deg,#f6f8ff,#eef2ff);}
      .wrap{min-height:100%;display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box;}
      .card{width:100%;max-width:380px;background:#fff;border-radius:16px;box-shadow:0 12px 40px rgba(60,70,120,.12);padding:32px 28px;box-sizing:border-box;}
      h1{font-size:20px;margin:0 0 4px;color:#1f2430;}
      .sub{color:#6b7280;font-size:13px;margin:0 0 22px;}
      label{display:block;font-size:13px;color:#374151;margin:14px 0 6px;}
      input{width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #d7dbe6;border-radius:10px;font-size:14px;outline:none;}
      input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(99,102,241,.15);}
      button{width:100%;margin-top:22px;padding:12px;border:0;border-radius:10px;background:var(--primary);color:#fff;font-size:15px;font-weight:600;cursor:pointer;}
      button:disabled{opacity:.6;cursor:default;}
      .msg{margin-top:16px;font-size:13px;padding:10px 12px;border-radius:10px;display:none;}
      .msg.err{display:block;background:#fdecec;color:#b3261e;}
      .msg.ok{display:block;background:#e9f7ef;color:#1e7a43;}
      .foot{margin-top:18px;text-align:center;font-size:13px;}
      a{color:var(--primary);text-decoration:none;}
    script.
      window.__TOKEN__ = !{JSON.stringify(token || '')};
  body
    .wrap
      .card
        h1 设置登录密码
        p.sub 为你的 Poleis 账号设置一个新密码，完成后即可登录。
        div(id="form")
          label(for="pw") 新密码（至少 8 位）
          input(id="pw" type="password" autocomplete="new-password" placeholder="请输入新密码")
          label(for="pw2") 确认新密码
          input(id="pw2" type="password" autocomplete="new-password" placeholder="请再次输入")
          button(id="submit" type="button") 设置密码并登录
        .msg(id="msg")
        .foot
          a(href="/login") 返回登录
    script.
      (function(){
        var token = window.__TOKEN__ || '';
        var msg = document.getElementById('msg');
        var btn = document.getElementById('submit');
        function show(type, text){ msg.className = 'msg ' + type; msg.textContent = text; }
        if(!token){ show('err','链接无效：缺少令牌。请向管理员索取新的邀请链接。'); btn.disabled = true; return; }
        btn.addEventListener('click', async function(){
          var pw = document.getElementById('pw').value;
          var pw2 = document.getElementById('pw2').value;
          if(pw.length < 8){ show('err','密码至少 8 位。'); return; }
          if(pw !== pw2){ show('err','两次输入的密码不一致。'); return; }
          btn.disabled = true; show('ok','正在提交…');
          try{
            var resp = await fetch('/auth/password/reset', {
              method:'POST', headers:{'Content-Type':'application/json'},
              body: JSON.stringify({ token: token, newPassword: pw })
            });
            var result = await resp.json();
            if(!resp.ok || !result.success){ throw new Error(result.message || '设置失败'); }
            show('ok','密码已设置，正在跳转到登录…');
            setTimeout(function(){ window.location.href = '/login'; }, 1200);
          }catch(e){ btn.disabled = false; show('err', e.message || '设置失败，请重试'); }
        });
      })();
