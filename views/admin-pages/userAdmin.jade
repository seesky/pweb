script.
  const UserAdminPage = () => {
    const [organizes, setOrganizes] = useState([]);
    const [organizeTree, setOrganizeTree] = useState([]);
    const [selectedOrganize, setSelectedOrganize] = useState(null);
    const [userRows, setUserRows] = useState([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState('');
    const [searchInput, setSearchInput] = useState('');
    const [keyword, setKeyword] = useState('');
    const [dialogState, setDialogState] = useState({ open: false, mode: 'create' });
    const [formValues, setFormValues] = useState(defaultUserForm());
    const [notify, setNotify] = useState({ open: false, severity: 'success', message: '' });
    const [saving, setSaving] = useState(false);
    const [selectedRow, setSelectedRow] = useState(null);
    const [confirmDelete, setConfirmDelete] = useState(false);

    const loadOrganizes = useCallback(async () => {
      try {
        const resp = await fetch('/user-admin/organizes');
        if (resp.status === 401) {
          window.location.href = '/login';
          return;
        }
        const result = await resp.json();
        if (!resp.ok) {
          throw new Error(result.message || '加载组织失败');
        }
        const list = result.data || [];
        setOrganizes(list);
        setOrganizeTree(buildOrganizeTree(list));
      } catch (err) {
        console.error(err);
      }
    }, []);

    useEffect(() => {
      loadOrganizes();
    }, [loadOrganizes]);

    const loadUsers = useCallback(async () => {
      setLoading(true);
      setError('');
      try {
        const params = new URLSearchParams();
        if (selectedOrganize) {
          params.append('organizeId', selectedOrganize);
        }
        if (keyword) {
          params.append('keyword', keyword);
        }
        const query = params.toString();
        const resp = await fetch(query ? `/user-admin/users?${query}` : '/user-admin/users');
        if (resp.status === 401) {
          window.location.href = '/login';
          return;
        }
        const result = await resp.json();
        if (!resp.ok) {
          throw new Error(result.message || '加载用户失败');
        }
        setUserRows(result.data || []);
      } catch (err) {
        setError(err.message || '加载用户失败');
      } finally {
        setLoading(false);
      }
    }, [selectedOrganize, keyword]);

    useEffect(() => {
      loadUsers();
    }, [loadUsers]);

    useEffect(() => {
      if (selectedRow && !userRows.some((row) => row.id === selectedRow.id)) {
        setSelectedRow(null);
      }
    }, [userRows, selectedRow]);

    const handleSearch = () => {
      setKeyword(searchInput.trim());
    };

    const handleOpenCreate = () => {
      setFormValues(defaultUserForm(selectedOrganize || ''));
      setDialogState({ open: true, mode: 'create' });
    };

    const handleOpenEdit = () => {
      if (!selectedRow) return;
      setFormValues(mapUserToFormValues(selectedRow));
      setDialogState({ open: true, mode: 'edit' });
    };

    const handleCloseDialog = () => {
      setDialogState({ open: false, mode: 'create' });
      setFormValues(defaultUserForm(selectedOrganize || ''));
    };

    const handleSave = async () => {
      setSaving(true);
      try {
        const payload = serializeUserForm(formValues);
        if (!payload.userName) {
          throw new Error('请填写用户名');
        }
        const isEdit = dialogState.mode === 'edit';
        const url = isEdit ? `/user-admin/users/${formValues.id}` : '/user-admin/users';
        const resp = await fetch(url, {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await resp.json();
        if (!resp.ok) {
          throw new Error(result.message || '保存失败');
        }
        setNotify({ open: true, severity: 'success', message: result.message || '保存成功' });
        handleCloseDialog();
        await loadUsers();
      } catch (err) {
        setNotify({ open: true, severity: 'error', message: err.message || '保存失败' });
      } finally {
        setSaving(false);
      }
    };

    const handleDelete = async () => {
      if (!selectedRow) return;
      setSaving(true);
      try {
        const resp = await fetch(`/user-admin/users/${selectedRow.id}`, { method: 'DELETE' });
        const result = await resp.json();
        if (!resp.ok) {
          throw new Error(result.message || '删除失败');
        }
        setNotify({ open: true, severity: 'success', message: result.message || '用户已删除' });
        setSelectedRow(null);
        await loadUsers();
      } catch (err) {
        setNotify({ open: true, severity: 'error', message: err.message || '删除失败' });
      } finally {
        setSaving(false);
        setConfirmDelete(false);
      }
    };

    const organizeOptions = useMemo(
      () => organizes.map((item) => ({ value: item.id, label: item.fullName })),
      [organizes]
    );

    return React.createElement(Box, {
      sx: {
        display: 'grid',
        gap: 3,
        gridTemplateColumns: { xs: '1fr', lg: '320px 1fr' }
      }
    },
    React.createElement(Paper, { sx: { p: 2.5, borderRadius: 3, height: 'fit-content' } },
      React.createElement(Typography, { variant: 'h6', mb: 1 }, '组织结构'),
      React.createElement(Typography, { variant: 'body2', color: 'text.secondary', mb: 2 }, '点击组织查看所属用户'),
      React.createElement(Divider, { sx: { mb: 2 } }),
      React.createElement(OrganizeTree, {
        data: organizeTree,
        selectedId: selectedOrganize,
        onSelect: setSelectedOrganize
      })
    ),
    React.createElement(Box, null,
      error ? React.createElement(Alert, { severity: 'error', sx: { mb: 2 } }, error) : null,
      React.createElement(Paper, { sx: { p: 2, borderRadius: 3, mb: 2 } },
        React.createElement(Stack, {
          direction: { xs: 'column', md: 'row' },
          spacing: 1.5,
          justifyContent: 'space-between'
        },
        React.createElement(Stack, { direction: 'row', spacing: 1, flexWrap: 'wrap', alignItems: 'center' },
          React.createElement(TextField, {
            label: '搜索姓名/账号/电话',
            value: searchInput,
            size: 'small',
            onChange: (event) => setSearchInput(event.target.value)
          }),
          React.createElement(Button, { variant: 'text', size: 'small', onClick: handleSearch }, '搜索')
        ),
        React.createElement(Stack, { direction: 'row', spacing: 1, flexWrap: 'wrap' },
          React.createElement(Button, { variant: 'contained', size: 'small', onClick: handleOpenCreate }, '新增用户'),
          React.createElement(Button, {
            variant: 'outlined',
            size: 'small',
            disabled: !selectedRow,
            onClick: handleOpenEdit
          }, '编辑'),
          React.createElement(Button, {
            variant: 'outlined',
            size: 'small',
            color: 'error',
            disabled: !selectedRow,
            onClick: () => setConfirmDelete(true)
          }, '删除'),
          React.createElement(Button, { variant: 'text', size: 'small', onClick: loadUsers, disabled: loading }, '刷新')
        )
        )
      ),
      React.createElement(Paper, { sx: { borderRadius: 3, position: 'relative' } },
        loading
          ? React.createElement(Box, {
              sx: {
                position: 'absolute',
                inset: 0,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                bgcolor: 'rgba(255,255,255,0.6)',
                zIndex: 1,
                borderRadius: 3
              }
            }, React.createElement(CircularProgress, { size: 32 }))
          : null,
        React.createElement(TableContainer, null,
          React.createElement(Table, { size: 'small' },
            React.createElement(TableHead, null,
              React.createElement(TableRow, null,
                React.createElement(TableCell, null, '姓名'),
                React.createElement(TableCell, null, '账号'),
                React.createElement(TableCell, null, '工号'),
                React.createElement(TableCell, null, '手机'),
                React.createElement(TableCell, null, '邮箱'),
                React.createElement(TableCell, null, '所属组织'),
                React.createElement(TableCell, null, '状态')
              )
            ),
            React.createElement(TableBody, null,
              userRows.map((row) =>
                React.createElement(TableRow, {
                  key: row.id,
                  hover: true,
                  selected: selectedRow?.id === row.id,
                  onClick: () => setSelectedRow(row),
                  sx: { cursor: 'pointer' }
                },
                React.createElement(TableCell, null, row.realName || row.userName || '-'),
                React.createElement(TableCell, null, row.userName || '-'),
                React.createElement(TableCell, null, row.code || '-'),
                React.createElement(TableCell, null, row.mobile || '-'),
                React.createElement(TableCell, null, row.email || '-'),
                React.createElement(TableCell, null, row.organizeName || '-'),
                React.createElement(TableCell, null,
                  React.createElement(Stack, { direction: 'row', spacing: 0.5 },
                    React.createElement(Chip, {
                      label: row.enabled ? '启用' : '停用',
                      size: 'small',
                      color: row.enabled ? 'success' : 'default',
                      variant: row.enabled ? 'filled' : 'outlined'
                    }),
                    row.isDimission
                      ? React.createElement(Chip, { label: '离职', size: 'small', color: 'warning', variant: 'outlined' })
                      : null
                  )
                )
                )
              )
            )
          )
        ),
        !userRows.length
          ? React.createElement(Box, { sx: { p: 4, textAlign: 'center', color: 'text.secondary' } }, '暂无符合条件的用户')
          : null
      )
    ),
    React.createElement(Dialog, {
      open: dialogState.open,
      onClose: handleCloseDialog,
      maxWidth: 'sm',
      fullWidth: true
    },
      React.createElement(DialogTitle, null, dialogState.mode === 'edit' ? '编辑用户' : '新增用户'),
      React.createElement(DialogContent, null,
        React.createElement(Stack, { spacing: 2, sx: { mt: 1 } },
          React.createElement(TextField, {
            label: '用户名',
            required: true,
            value: formValues.userName,
            onChange: (event) => setFormValues((prev) => ({ ...prev, userName: event.target.value }))
          }),
          React.createElement(TextField, {
            label: '姓名',
            value: formValues.realName,
            onChange: (event) => setFormValues((prev) => ({ ...prev, realName: event.target.value }))
          }),
          React.createElement(TextField, {
            label: '工号',
            value: formValues.code,
            onChange: (event) => setFormValues((prev) => ({ ...prev, code: event.target.value }))
          }),
          React.createElement(TextField, {
            label: '手机号',
            value: formValues.mobile,
            onChange: (event) => setFormValues((prev) => ({ ...prev, mobile: event.target.value }))
          }),
          React.createElement(TextField, {
            label: '邮箱',
            value: formValues.email,
            onChange: (event) => setFormValues((prev) => ({ ...prev, email: event.target.value }))
          }),
          React.createElement(TextField, {
            label: '所属组织',
            select: true,
            value: formValues.organizeId,
            onChange: (event) => setFormValues((prev) => ({ ...prev, organizeId: event.target.value })),
            children: [
              React.createElement(MenuItem, { key: 'empty', value: '' }, '未设置'),
              ...organizeOptions.map((opt) =>
                React.createElement(MenuItem, { key: opt.value, value: opt.value }, opt.label)
              )
            ]
          }),
          React.createElement(TextField, {
            label: '排序码',
            type: 'number',
            value: formValues.sortCode,
            onChange: (event) => setFormValues((prev) => ({ ...prev, sortCode: event.target.value }))
          }),
          React.createElement(Stack, { direction: 'row', spacing: 1 },
            React.createElement(FormControlLabel, {
              control: React.createElement(Switch, {
                checked: formValues.enabled,
                onChange: (event) => setFormValues((prev) => ({ ...prev, enabled: event.target.checked }))
              }),
              label: '启用'
            }),
            React.createElement(FormControlLabel, {
              control: React.createElement(Switch, {
                checked: formValues.isDimission,
                onChange: (event) => setFormValues((prev) => ({ ...prev, isDimission: event.target.checked }))
              }),
              label: '已离职'
            })
          )
        )
      ),
      React.createElement(DialogActions, null,
        React.createElement(Button, { onClick: handleCloseDialog }, '取消'),
        React.createElement(Button, { variant: 'contained', onClick: handleSave, disabled: saving }, '保存')
      )
    ),
    React.createElement(Dialog, { open: confirmDelete, onClose: () => setConfirmDelete(false) },
      React.createElement(DialogTitle, null, '删除用户'),
      React.createElement(DialogContent, null,
        React.createElement(Typography, null, '确定删除所选用户吗？')
      ),
      React.createElement(DialogActions, null,
        React.createElement(Button, { onClick: () => setConfirmDelete(false) }, '取消'),
        React.createElement(Button, { color: 'error', onClick: handleDelete, disabled: saving }, '删除')
      )
    ),
    React.createElement(Snackbar, {
      open: notify.open,
      autoHideDuration: 3200,
      onClose: () => setNotify((prev) => ({ ...prev, open: false }))
    },
      React.createElement(Alert, {
        onClose: () => setNotify((prev) => ({ ...prev, open: false })),
        severity: notify.severity,
        sx: { width: '100%' }
      }, notify.message)
    )
    );
  };

  const defaultUserForm = (organizeId = '') => ({
    id: '',
    userName: '',
    realName: '',
    code: '',
    mobile: '',
    email: '',
    organizeId: organizeId || '',
    sortCode: '',
    enabled: true,
    isDimission: false
  });

  const mapUserToFormValues = (record) =>
    record
      ? {
          id: record.id,
          userName: record.userName || '',
          realName: record.realName || '',
          code: record.code || '',
          mobile: record.mobile || '',
          email: record.email || '',
          organizeId: record.organizeId || '',
          sortCode: record.sortCode ?? '',
          enabled: !!record.enabled,
          isDimission: !!record.isDimission
        }
      : defaultUserForm();

  const serializeUserForm = (values) => ({
    userName: values.userName?.trim(),
    realName: values.realName?.trim(),
    code: values.code?.trim(),
    mobile: values.mobile?.trim(),
    email: values.email?.trim(),
    organizeId: values.organizeId || null,
    sortCode: values.sortCode === '' ? null : Number(values.sortCode),
    enabled: !!values.enabled,
    isDimission: !!values.isDimission
  });