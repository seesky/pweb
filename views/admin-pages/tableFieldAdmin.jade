script.
  const defaultTableFieldState = {
    id: '',
    tableCode: '',
    tableName: '',
    columnCode: '',
    columnName: '',
    dataType: '',
    isPublic: false,
    columnAccess: false,
    columnEdit: false,
    columnDeny: false,
    useConstraint: false,
    isSearchColumn: false,
    isExhibitColumn: false,
    enabled: true,
    allowEdit: true,
    allowDelete: true,
    sortCode: '',
    description: ''
  };

  const TableFieldAdminPage = () => {
    const [tables, setTables] = useState([]);
    const [tableFilter, setTableFilter] = useState('');
    const [tableLoading, setTableLoading] = useState(false);
    const [selectedTable, setSelectedTable] = useState(null);
    const [columns, setColumns] = useState([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState('');
    const [page, setPage] = useState(1);
    const [pageSize, setPageSize] = useState(10);
    const [total, setTotal] = useState(0);
    const [searchInput, setSearchInput] = useState('');
    const [keyword, setKeyword] = useState('');
    const [selectedRow, setSelectedRow] = useState(null);
    const [dialogState, setDialogState] = useState({ open: false, mode: 'create' });
    const [formValues, setFormValues] = useState({ ...defaultTableFieldState });
    const [saving, setSaving] = useState(false);
    const [confirmDelete, setConfirmDelete] = useState(false);
    const [notify, setNotify] = useState({ open: false, severity: 'success', message: '' });

    const closeNotify = () => setNotify((prev) => ({ ...prev, open: false }));

    const loadTables = useCallback(async () => {
      setTableLoading(true);
      try {
        const resp = await fetch('/table-field-admin/tables');
        if (resp.status === 401) {
          window.location.href = '/login';
          return;
        }
        const result = await resp.json();
        if (resp.ok) {
          setTables(result.data || []);
          if (!selectedTable && result.data?.length) {
            setSelectedTable(result.data[0]);
          }
        }
      } catch (error) {
        console.error(error);
      } finally {
        setTableLoading(false);
      }
    }, [selectedTable]);

    useEffect(() => {
      loadTables();
    }, [loadTables]);

    const loadColumns = useCallback(async () => {
      setLoading(true);
      setError('');
      try {
        const params = new URLSearchParams({
          page: String(page),
          pageSize: String(pageSize)
        });
        if (keyword) {
          params.append('keyword', keyword);
        }
        if (selectedTable?.tableCode) {
          params.append('tableCode', selectedTable.tableCode);
        }
        const resp = await fetch(`/table-field-admin/columns?${params.toString()}`);
        if (resp.status === 401) {
          window.location.href = '/login';
          return;
        }
        const result = await resp.json();
        if (!resp.ok) {
          throw new Error(result.message || '获取字段列表失败');
        }
        setColumns(result.data || []);
        setTotal(result.total || 0);
        if (selectedRow && !(result.data || []).find((item) => item.id === selectedRow.id)) {
          setSelectedRow(null);
        }
      } catch (err) {
        setError(err.message || '获取字段列表失败');
      } finally {
        setLoading(false);
      }
    }, [page, pageSize, keyword, selectedTable, selectedRow]);

    useEffect(() => {
      loadColumns();
    }, [loadColumns]);

    useEffect(() => {
      setPage(1);
      setSelectedRow(null);
    }, [selectedTable]);

    const handleSearch = () => {
      setKeyword(searchInput.trim());
      setPage(1);
    };

    const handleOpenCreate = () => {
      setFormValues({
        ...defaultTableFieldState,
        tableCode: selectedTable?.tableCode || '',
        tableName: selectedTable?.tableName || ''
      });
      setDialogState({ open: true, mode: 'create' });
    };

    const handleOpenEdit = async () => {
      if (!selectedRow) {
        return;
      }
      try {
        const resp = await fetch(`/table-field-admin/columns/${selectedRow.id}`);
        if (resp.status === 401) {
          window.location.href = '/login';
          return;
        }
        const result = await resp.json();
        if (!resp.ok) {
          throw new Error(result.message || '获取字段详情失败');
        }
        setFormValues({
          id: result.data?.id || '',
          tableCode: result.data?.tableCode || '',
          tableName: result.data?.tableName || '',
          columnCode: result.data?.columnCode || '',
          columnName: result.data?.columnName || '',
          dataType: result.data?.dataType || '',
          isPublic: !!result.data?.isPublic,
          columnAccess: !!result.data?.columnAccess,
          columnEdit: !!result.data?.columnEdit,
          columnDeny: !!result.data?.columnDeny,
          useConstraint: !!result.data?.useConstraint,
          isSearchColumn: !!result.data?.isSearchColumn,
          isExhibitColumn: !!result.data?.isExhibitColumn,
          enabled: !!result.data?.enabled,
          allowEdit: !!result.data?.allowEdit,
          allowDelete: !!result.data?.allowDelete,
          sortCode: result.data?.sortCode ?? '',
          description: result.data?.description || ''
        });
        setDialogState({ open: true, mode: 'edit' });
      } catch (error) {
        setNotify({ open: true, severity: 'error', message: error.message || '获取字段详情失败' });
      }
    };

    const handleCloseDialog = () => {
      setDialogState({ open: false, mode: 'create' });
      setFormValues({ ...defaultTableFieldState });
    };

    const normalizePayload = () => ({
      tableCode: (formValues.tableCode || '').trim(),
      tableName: (formValues.tableName || '').trim(),
      columnCode: (formValues.columnCode || '').trim(),
      columnName: (formValues.columnName || '').trim(),
      dataType: (formValues.dataType || '').trim(),
      isPublic: !!formValues.isPublic,
      columnAccess: !!formValues.columnAccess,
      columnEdit: !!formValues.columnEdit,
      columnDeny: !!formValues.columnDeny,
      useConstraint: !!formValues.useConstraint,
      isSearchColumn: !!formValues.isSearchColumn,
      isExhibitColumn: !!formValues.isExhibitColumn,
      enabled: !!formValues.enabled,
      allowEdit: !!formValues.allowEdit,
      allowDelete: !!formValues.allowDelete,
      sortCode: formValues.sortCode === '' ? null : Number(formValues.sortCode),
      description: formValues.description?.trim() || ''
    });

    const handleSave = async () => {
      const payload = normalizePayload();
      if (!payload.tableCode || !payload.columnCode) {
        setNotify({ open: true, severity: 'error', message: '请填写表名与英文字段名' });
        return;
      }
      setSaving(true);
      try {
        const isEdit = dialogState.mode === 'edit';
        const url = isEdit ? `/table-field-admin/columns/${formValues.id}` : '/table-field-admin/columns';
        const resp = await fetch(url, {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await resp.json();
        if (!resp.ok) {
          throw new Error(result.message || '保存字段失败');
        }
        setNotify({ open: true, severity: 'success', message: result.message || '字段已保存' });
        handleCloseDialog();
        await loadColumns();
        await loadTables();
      } catch (error) {
        setNotify({ open: true, severity: 'error', message: error.message || '保存字段失败' });
      } finally {
        setSaving(false);
      }
    };

    const handleDelete = async () => {
      if (!selectedRow) {
        return;
      }
      setSaving(true);
      try {
        const resp = await fetch(`/table-field-admin/columns/${selectedRow.id}`, { method: 'DELETE' });
        const result = await resp.json();
        if (!resp.ok) {
          throw new Error(result.message || '删除字段失败');
        }
        setNotify({ open: true, severity: 'success', message: result.message || '字段已删除' });
        setSelectedRow(null);
        await loadColumns();
      } catch (error) {
        setNotify({ open: true, severity: 'error', message: error.message || '删除字段失败' });
      } finally {
        setSaving(false);
        setConfirmDelete(false);
      }
    };

    const filteredTables = useMemo(() => {
      const keyword = tableFilter.trim().toLowerCase();
      if (!keyword) {
        return tables;
      }
      return tables.filter((table) =>
        (table.tableName || '').toLowerCase().includes(keyword) ||
        (table.tableCode || '').toLowerCase().includes(keyword)
      );
    }, [tableFilter, tables]);

    const BooleanChip = ({ value }) =>
      React.createElement(Chip, {
        size: 'small',
        label: value ? '是' : '否',
        color: value ? 'success' : 'default',
        variant: value ? 'filled' : 'outlined'
      });

    const totalPages = Math.max(1, Math.ceil(total / pageSize));

    return React.createElement(Box, {
      sx: {
        display: 'grid',
        gap: 3,
        gridTemplateColumns: { xs: '1fr', lg: '280px 1fr' }
      }
    },
      React.createElement(Paper, { sx: { p: 2, borderRadius: 3, height: 'fit-content' } },
        React.createElement(Stack, { spacing: 1.5 },
          React.createElement(TextField, {
            size: 'small',
            label: '搜索数据表',
            value: tableFilter,
            onChange: (event) => setTableFilter(event.target.value)
          }),
          tableLoading
            ? React.createElement(Box, { sx: { display: 'flex', justifyContent: 'center', py: 4 } },
                React.createElement(CircularProgress, { size: 24 })
              )
            : React.createElement(List, { sx: { maxHeight: 440, overflowY: 'auto' } },
                filteredTables.length
                  ? filteredTables.map((table) =>
                      React.createElement(ListItemButton, {
                        key: table.tableCode || table.tableName,
                        selected: selectedTable?.tableCode === table.tableCode,
                        onClick: () => setSelectedTable(table)
                      },
                        React.createElement(ListItemText, {
                          primary: table.tableName || table.tableCode,
                          secondary: table.tableCode
                        })
                      )
                    )
                  : React.createElement(Typography, {
                      variant: 'body2',
                      color: 'text.secondary',
                      sx: { textAlign: 'center', py: 4 }
                    }, '暂无可用数据表')
              )
        )
      ),
      React.createElement(Box, null,
        React.createElement(Paper, { sx: { p: 2, borderRadius: 3, mb: 2 } },
          React.createElement(Stack, {
            direction: { xs: 'column', md: 'row' },
            spacing: 1.5,
            alignItems: { xs: 'stretch', md: 'center' },
            justifyContent: 'space-between'
          },
            React.createElement(Stack, { spacing: 0.25 },
              React.createElement(Typography, { variant: 'h6' }, selectedTable?.tableName || '表字段列表'),
              React.createElement(Typography, { variant: 'caption', color: 'text.secondary' },
                selectedTable?.tableCode ? `当前表：${selectedTable.tableCode}` : '请选择左侧数据表')
            ),
            React.createElement(Stack, { direction: { xs: 'column', sm: 'row' }, spacing: 1 },
              React.createElement(TextField, {
                size: 'small',
                label: '搜索字段',
                value: searchInput,
                onChange: (event) => setSearchInput(event.target.value)
              }),
              React.createElement(Button, { variant: 'contained', onClick: handleSearch }, '搜索'),
              React.createElement(Button, { variant: 'outlined', onClick: handleOpenCreate }, '新增字段'),
              React.createElement(Button, {
                variant: 'outlined',
                disabled: !selectedRow,
                onClick: handleOpenEdit
              }, '编辑'),
              React.createElement(Button, {
                variant: 'outlined',
                color: 'error',
                disabled: !selectedRow,
                onClick: () => setConfirmDelete(true)
              }, '删除'),
              React.createElement(Button, { variant: 'text', onClick: loadColumns }, '刷新')
            )
          )
        ),
        error ? React.createElement(Alert, { severity: 'error', sx: { mb: 2 } }, error) : null,
        React.createElement(Paper, { sx: { borderRadius: 3, overflow: 'hidden' } },
          loading ? React.createElement(LinearProgress, null) : null,
          React.createElement(TableContainer, null,
            React.createElement(Table, { size: 'small' },
              React.createElement(TableHead, null,
                React.createElement(TableRow, null,
                  React.createElement(TableCell, null, '英文字段'),
                  React.createElement(TableCell, null, '中文名称'),
                  React.createElement(TableCell, null, '数据类型'),
                  React.createElement(TableCell, null, '公开'),
                  React.createElement(TableCell, null, '允许访问'),
                  React.createElement(TableCell, null, '允许编辑'),
                  React.createElement(TableCell, null, '拒绝访问'),
                  React.createElement(TableCell, null, '使用约束'),
                  React.createElement(TableCell, null, '查询列'),
                  React.createElement(TableCell, null, '展示列'),
                  React.createElement(TableCell, null, '启用'),
                  React.createElement(TableCell, null, '排序码'),
                  React.createElement(TableCell, null, '描述')
                )
              ),
              React.createElement(TableBody, null,
                columns.length
                  ? columns.map((item) =>
                      React.createElement(TableRow, {
                        key: item.id,
                        hover: true,
                        selected: selectedRow?.id === item.id,
                        onClick: () => setSelectedRow(item),
                        sx: { cursor: 'pointer' }
                      },
                        React.createElement(TableCell, null, item.columnCode || '-'),
                        React.createElement(TableCell, null, item.columnName || '-'),
                        React.createElement(TableCell, null, item.dataType || '-'),
                        React.createElement(TableCell, null, React.createElement(BooleanChip, { value: item.isPublic })),
                        React.createElement(TableCell, null, React.createElement(BooleanChip, { value: item.columnAccess })),
                        React.createElement(TableCell, null, React.createElement(BooleanChip, { value: item.columnEdit })),
                        React.createElement(TableCell, null, React.createElement(BooleanChip, { value: item.columnDeny })),
                        React.createElement(TableCell, null, React.createElement(BooleanChip, { value: item.useConstraint })),
                        React.createElement(TableCell, null, React.createElement(BooleanChip, { value: item.isSearchColumn })),
                        React.createElement(TableCell, null, React.createElement(BooleanChip, { value: item.isExhibitColumn })),
                        React.createElement(TableCell, null, React.createElement(BooleanChip, { value: item.enabled })),
                        React.createElement(TableCell, null, item.sortCode ?? '-'),
                        React.createElement(TableCell, null, item.description || '-')
                      )
                    )
                  : React.createElement(TableRow, null,
                      React.createElement(TableCell, {
                        colSpan: 13,
                        align: 'center',
                        sx: { py: 4, color: 'text.secondary' }
                      }, loading ? '正在加载...' : '暂无数据')
                    )
              )
            )
          ),
          React.createElement(Divider, null),
          React.createElement(Box, {
            sx: {
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              flexWrap: 'wrap',
              p: 2,
              gap: 1.5
            }
          },
            React.createElement(TextField, {
              select: true,
              size: 'small',
              label: '每页',
              value: pageSize,
              onChange: (event) => {
                setPageSize(Number(event.target.value));
                setPage(1);
              },
              sx: { minWidth: 90 }
            },
              [10, 20, 50, 100].map((size) =>
                React.createElement(MenuItem, { key: size, value: size }, `${size} 条`)
              )
            ),
            React.createElement(Pagination, {
              count: totalPages,
              page,
              onChange: (event, value) => setPage(value),
              color: 'primary'
            })
          )
        )
      ),
      React.createElement(Dialog, { open: dialogState.open, onClose: handleCloseDialog, maxWidth: 'md', fullWidth: true },
        React.createElement(DialogTitle, null, dialogState.mode === 'edit' ? '编辑字段' : '新增字段'),
        React.createElement(DialogContent, null,
          React.createElement(Stack, { spacing: 2, mt: 1 },
            React.createElement(Stack, { direction: { xs: 'column', sm: 'row' }, spacing: 2 },
              React.createElement(TextField, {
                label: '表名（中文）',
                value: formValues.tableName,
                onChange: (event) => setFormValues((prev) => ({ ...prev, tableName: event.target.value }))
              }),
              React.createElement(TextField, {
                label: '表名（英文）',
                required: true,
                value: formValues.tableCode,
                onChange: (event) => setFormValues((prev) => ({ ...prev, tableCode: event.target.value }))
              })
            ),
            React.createElement(Stack, { direction: { xs: 'column', sm: 'row' }, spacing: 2 },
              React.createElement(TextField, {
                label: '字段英文名',
                required: true,
                value: formValues.columnCode,
                onChange: (event) => setFormValues((prev) => ({ ...prev, columnCode: event.target.value }))
              }),
              React.createElement(TextField, {
                label: '字段中文名',
                value: formValues.columnName,
                onChange: (event) => setFormValues((prev) => ({ ...prev, columnName: event.target.value }))
              }),
              React.createElement(TextField, {
                label: '数据类型',
                value: formValues.dataType,
                onChange: (event) => setFormValues((prev) => ({ ...prev, dataType: event.target.value }))
              })
            ),
            React.createElement(Stack, { direction: { xs: 'column', sm: 'row' }, spacing: 2 },
              React.createElement(TextField, {
                label: '排序码',
                type: 'number',
                value: formValues.sortCode,
                onChange: (event) => setFormValues((prev) => ({ ...prev, sortCode: event.target.value }))
              }),
              React.createElement(TextField, {
                label: '描述',
                multiline: true,
                minRows: 2,
                value: formValues.description,
                onChange: (event) => setFormValues((prev) => ({ ...prev, description: event.target.value }))
              })
            ),
            React.createElement(Stack, { direction: 'row', spacing: 2, flexWrap: 'wrap' },
              [
                { label: '公开', field: 'isPublic' },
                { label: '允许访问', field: 'columnAccess' },
                { label: '允许编辑', field: 'columnEdit' },
                { label: '拒绝访问', field: 'columnDeny' },
                { label: '使用约束', field: 'useConstraint' },
                { label: '查询列', field: 'isSearchColumn' },
                { label: '展示列', field: 'isExhibitColumn' },
                { label: '启用', field: 'enabled' },
                { label: '允许编辑属性', field: 'allowEdit' },
                { label: '允许删除', field: 'allowDelete' }
              ].map((item) =>
                React.createElement(FormControlLabel, {
                  key: item.field,
                  control: React.createElement(Switch, {
                    checked: formValues[item.field],
                    onChange: (event) =>
                      setFormValues((prev) => ({ ...prev, [item.field]: event.target.checked }))
                  }),
                  label: item.label
                })
              )
            )
          )
        ),
        React.createElement(DialogActions, null,
          React.createElement(Button, { onClick: handleCloseDialog }, '取消'),
          React.createElement(Button, { variant: 'contained', onClick: handleSave, disabled: saving }, '保存')
        )
      ),
      React.createElement(Dialog, { open: confirmDelete, onClose: () => setConfirmDelete(false) },
        React.createElement(DialogTitle, null, '删除字段'),
        React.createElement(DialogContent, null,
          React.createElement(Typography, null, '确定删除所选字段吗？')
        ),
        React.createElement(DialogActions, null,
          React.createElement(Button, { onClick: () => setConfirmDelete(false) }, '取消'),
          React.createElement(Button, { color: 'error', onClick: handleDelete, disabled: saving }, '删除')
        )
      ),
      React.createElement(Snackbar, { open: notify.open, autoHideDuration: 3200, onClose: closeNotify },
        React.createElement(Alert, { severity: notify.severity, onClose: closeNotify, sx: { width: '100%' } }, notify.message)
      )
    );
  };
