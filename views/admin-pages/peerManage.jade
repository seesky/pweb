script.
  // ===== Poleis 控制台（现代 SaaS 风 / 自带侧栏 + 顶栏） =====
  const PM_H = React.createElement;

  const PM_GRADS = {
    indigo: 'linear-gradient(135deg,#6366f1,#8b5cf6)',
    blue: 'linear-gradient(135deg,#0ea5e9,#3b82f6)',
    emerald: 'linear-gradient(135deg,#10b981,#34d399)',
    amber: 'linear-gradient(135deg,#f59e0b,#fbbf24)',
    rose: 'linear-gradient(135deg,#f43f5e,#fb7185)',
    slate: 'linear-gradient(135deg,#64748b,#94a3b8)'
  };
  const PM_CARD_SX = {
    borderRadius: 3,
    border: '1px solid #eef0f4',
    boxShadow: '0 1px 2px rgba(16,24,40,.04), 0 1px 3px rgba(16,24,40,.06)'
  };

  const pmIcon = (name, props) => PM_H(MaterialUI.Icon, Object.assign({ fontSize: 'small' }, props || {}), name);

  const pmFormatDate = (value) => (value ? new Date(value).toLocaleString('zh-CN', { hour12: false }) : '-');
  const pmIsToday = (value) => {
    if (!value) return false;
    const d = new Date(value); const n = new Date();
    return d.getFullYear() === n.getFullYear() && d.getMonth() === n.getMonth() && d.getDate() === n.getDate();
  };
  const pmTimeAgo = (value) => {
    if (!value) return '从未';
    const diff = Date.now() - new Date(value).getTime();
    if (diff < 60000) return '刚刚';
    if (diff < 3600000) return Math.floor(diff / 60000) + ' 分钟前';
    if (diff < 86400000) return Math.floor(diff / 3600000) + ' 小时前';
    if (diff < 2592000000) return Math.floor(diff / 86400000) + ' 天前';
    return new Date(value).toLocaleDateString('zh-CN');
  };
  const pmFormatDuration = (sec) => {
    if (!sec && sec !== 0) return '-';
    if (sec < 60) return sec + ' 秒';
    if (sec < 3600) return Math.floor(sec / 60) + ' 分 ' + (sec % 60) + ' 秒';
    return Math.floor(sec / 3600) + ' 时 ' + Math.floor((sec % 3600) / 60) + ' 分';
  };

  // KPI 卡片
  const PmKpiCard = ({ label, value, hint, icon, grad }) =>
    PM_H(MaterialUI.Paper, { sx: Object.assign({ p: 2.5, display: 'flex', alignItems: 'center', gap: 2 }, PM_CARD_SX) },
      PM_H(MaterialUI.Box, {
        sx: { width: 50, height: 50, borderRadius: 2.5, background: PM_GRADS[grad] || PM_GRADS.indigo, color: '#fff', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0, boxShadow: '0 6px 16px rgba(99,102,241,.25)' }
      }, pmIcon(icon, { sx: { fontSize: 26 } })),
      PM_H(MaterialUI.Box, { sx: { minWidth: 0 } },
        PM_H(MaterialUI.Typography, { sx: { fontSize: 28, fontWeight: 800, lineHeight: 1.1, color: '#101828' } }, String(value)),
        PM_H(MaterialUI.Typography, { variant: 'body2', sx: { color: '#667085', mt: 0.25 } }, label),
        hint ? PM_H(MaterialUI.Typography, { variant: 'caption', sx: { color: '#98a2b3' } }, hint) : null
      )
    );

  // 内容区卡片（带标题）
  const PmPanel = ({ title, subtitle, action, dense, children }) =>
    PM_H(MaterialUI.Paper, { sx: Object.assign({ overflow: 'hidden' }, PM_CARD_SX) },
      (title || action)
        ? PM_H(MaterialUI.Box, { sx: { px: 2.5, py: 2, display: 'flex', alignItems: 'center', justifyContent: 'space-between', borderBottom: '1px solid #f0f1f4' } },
            PM_H(MaterialUI.Box, null,
              title ? PM_H(MaterialUI.Typography, { sx: { fontWeight: 700, color: '#101828' } }, title) : null,
              subtitle ? PM_H(MaterialUI.Typography, { variant: 'caption', sx: { color: '#98a2b3' } }, subtitle) : null
            ),
            action || null
          )
        : null,
      PM_H(MaterialUI.Box, { sx: { p: dense ? 0 : 2.5 } }, children)
    );

  const PmStatusChip = (status) =>
    PM_H(MaterialUI.Box, { sx: { display: 'inline-flex', alignItems: 'center', gap: 0.75 } },
      PM_H(MaterialUI.Box, { sx: { width: 8, height: 8, borderRadius: '50%', background: status === 'online' ? '#12b76a' : '#d0d5dd', boxShadow: status === 'online' ? '0 0 0 3px rgba(18,183,106,.15)' : 'none' } }),
      PM_H(MaterialUI.Typography, { variant: 'body2', sx: { color: status === 'online' ? '#027a48' : '#667085', fontWeight: 500 } }, status === 'online' ? '在线' : '离线')
    );

  const PmEmpty = ({ icon, title, hint }) =>
    PM_H(MaterialUI.Box, { sx: { py: 7, textAlign: 'center' } },
      PM_H(MaterialUI.Box, { sx: { width: 64, height: 64, borderRadius: '50%', background: '#f2f4f7', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', color: '#98a2b3', mb: 1.5 } }, pmIcon(icon, { sx: { fontSize: 30 } })),
      PM_H(MaterialUI.Typography, { sx: { fontWeight: 600, color: '#475467' } }, title),
      hint ? PM_H(MaterialUI.Typography, { variant: 'body2', sx: { color: '#98a2b3', mt: 0.5, maxWidth: 420, mx: 'auto' } }, hint) : null
    );

  const PM_SECTIONS = [
    { key: 'overview', label: '总览', icon: 'dashboard', title: '总览', subtitle: '远程控制服务的整体运行态势' },
    { key: 'devices', label: '设备资产', icon: 'devices', title: '设备资产', subtitle: '纳管设备、设备组与注册令牌' },
    { key: 'sessions', label: '会话记录', icon: 'cast_connected', title: '会话记录', subtitle: '远程控制会话与连接质量' },
    { key: 'network', label: '网络与中继', icon: 'settings_ethernet', title: '网络与中继', subtitle: 'P2P 成功率、中继占比与 NAT 分布' },
    { key: 'access', label: '访问授权', icon: 'verified_user', title: '访问授权', subtitle: '谁可以连接哪些设备' },
    { key: 'members', label: '成员管理', icon: 'group', title: '成员管理', subtitle: '空间成员与角色（角色授权的依据）' },
    { key: 'policies', label: '权限模板', icon: 'tune', title: '权限模板', subtitle: '一次会话允许的能力（键鼠/文件/剪贴板/确认/超时）' },
    { key: 'devicePolicies', label: '设备策略', icon: 'settings', title: '设备策略', subtitle: '设备侧客户端运行配置（码率/帧率/传输/更新/日志），可按设备或设备组绑定并继承' },
    { key: 'deploy', label: '部署中心', icon: 'cloud_download', title: '部署中心', subtitle: '客户端版本发布、渠道管理与安装纳管指引' },
    { key: 'tickets', label: '支持工单', icon: 'confirmation_number', title: '支持工单', subtitle: '报修、接单、指派、沟通与处理' },
    { key: 'audit', label: '审计日志', icon: 'assignment', title: '审计日志', subtitle: '关键操作的合规记录' },
    { key: 'settings', label: '企业设置', icon: 'business', title: '企业设置', subtitle: '企业信息、配额用量与成员邀请' }
  ];

  // 权限模板能力位（与后端 poleis_permission_profile 列一一对应）
  const PM_PROFILE_CAPS = [
    { key: 'controlInput', label: '键鼠控制', icon: 'mouse' },
    { key: 'fileTransfer', label: '文件传输', icon: 'insert_drive_file' },
    { key: 'clipboard', label: '剪贴板', icon: 'content_paste' },
    { key: 'audio', label: '音频', icon: 'volume_up' },
    { key: 'multiMonitor', label: '多显示器', icon: 'desktop_windows' },
    { key: 'gamepad', label: '游戏手柄', icon: 'videogame_asset' },
    { key: 'remoteReboot', label: '远程重启', icon: 'power_settings_new' },
    { key: 'privacyScreen', label: '隐私屏', icon: 'visibility_off' },
    { key: 'recordSession', label: '会话录制', icon: 'videocam' }
  ];
  // 会话事件类型 → 展示（图标 + 文案 + 颜色）
  const PM_EVENT_META = {
    request: { icon: 'send', label: '发起连接', color: '#6366f1' },
    nat_info: { icon: 'info', label: 'NAT 信息交换', color: '#0ea5e9' },
    nat_punch: { icon: 'flash_on', label: '开始打洞', color: '#f59e0b' },
    connected: { icon: 'check_circle', label: '连接成功', color: '#12b76a' },
    relay_fallback: { icon: 'cloud', label: '回退中继', color: '#f59e0b' },
    failed: { icon: 'error', label: '连接失败', color: '#f04438' },
    disconnect: { icon: 'link_off', label: '断开', color: '#667085' }
  };
  const pmEventMeta = (type) => PM_EVENT_META[type] || { icon: 'fiber_manual_record', label: type, color: '#98a2b3' };
  const PM_TRANSPORT_LABELS = { auto: '自动', p2p: '优先 P2P', relay: '优先中继' };
  const PM_CHANNEL_LABELS = { stable: '稳定', beta: '测试', gray: '灰度' };
  const PM_CHANNEL_COLORS = { stable: 'success', beta: 'info', gray: 'warning' };
  const PM_TICKET_STATUS = { open: '待处理', in_progress: '处理中', resolved: '已解决', closed: '已关闭' };
  const PM_TICKET_STATUS_COLORS = { open: 'warning', in_progress: 'info', resolved: 'success', closed: 'default' };
  const PM_TICKET_PRIORITY = { low: '低', normal: '普通', high: '高', urgent: '紧急' };
  const PM_TICKET_PRIORITY_COLORS = { low: 'default', normal: 'info', high: 'warning', urgent: 'error' };
  const pmEmptyBuildForm = () => ({ version: '', channel: 'stable', url: '', notes: '', presetServerUrl: '', presetGroupId: '', presetPolicyId: '' });
  const pmEmptyDevicePolicyForm = () => ({
    name: '', priority: 0, maxBitrateKbps: 0, maxFps: 0, preferTransport: 'auto', autoUpdate: true, logRetentionDays: 14
  });
  const pmEmptyProfileForm = () => ({
    name: '', controlInput: true, fileTransfer: false, clipboard: false, audio: false,
    multiMonitor: true, gamepad: false, remoteReboot: false, privacyScreen: false,
    recordSession: false, requireConfirm: true, idleTimeoutSec: 0
  });

  const PeerManagePage = (props) => {
    const data = window.__APP_DATA__ || {};
    const currentUser = data.user || {};
    const currentTenant = data.tenant || {};
    const currentFeatures = data.features || {};
    const isPersonalMode = currentTenant.type === 'personal';
    const isTenantAdmin = isPersonalMode ||
      (currentTenant.role === 'owner' || currentTenant.role === 'admin');
    const hasDeviceGroups = currentFeatures.deviceGroups !== false && !isPersonalMode && isTenantAdmin;
    const hasEnrollmentTokens = currentFeatures.enrollmentTokens !== false && !isPersonalMode && isTenantAdmin;
    const hasAssignments = currentFeatures.assignments !== false && !isPersonalMode && isTenantAdmin;
    // 控制台区块可见性：后端 ensureAdmin 已防写，前端侧栏/数据加载亦按角色裁剪。
    const visibleSections = PM_SECTIONS.filter((item) => {
      if (isPersonalMode) return ['overview', 'devices', 'sessions'].includes(item.key);
      if (isTenantAdmin) return true;
      return ['overview', 'devices', 'sessions', 'tickets'].includes(item.key);
    });
    const embeddedSection = props && props.section;
    const embedded = !!embeddedSection;

    const [section, setSection] = useState(embeddedSection || 'overview');
    const [deviceTab, setDeviceTab] = useState('list');
    const [devices, setDevices] = useState([]);
    const [groups, setGroups] = useState([]);
    const [tokens, setTokens] = useState([]);
    const [sessions, setSessions] = useState([]);
    const [profiles, setProfiles] = useState([]);
    const [assignments, setAssignments] = useState([]);
    const [users, setUsers] = useState([]);
    const [auditLogs, setAuditLogs] = useState([]);
    const [keyword, setKeyword] = useState('');
    const [statusFilter, setStatusFilter] = useState('all');
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState('');
    const [editingDevice, setEditingDevice] = useState(null);
    const [deviceForm, setDeviceForm] = useState({ alias: '', groupId: '', policyId: '', tags: '', unattended: false, enabled: true });
    const [groupName, setGroupName] = useState('');
    const [tokenForm, setTokenForm] = useState({ groupId: '', maxUses: 0, expiresAt: '' });
    const [assignmentForm, setAssignmentForm] = useState({
      subjectType: 'user', subjectId: '', targetType: 'device', targetId: '',
      profileId: '', startDate: '', endDate: '', allowedCidr: ''
    });
    const [notify, setNotify] = useState({ open: false, severity: 'success', message: '' });
    const [editingProfile, setEditingProfile] = useState(null); // null | { mode:'new' } | { mode:'edit', id }
    const [profileForm, setProfileForm] = useState(pmEmptyProfileForm());
    const [members, setMembers] = useState([]);
    const [networkOverview, setNetworkOverview] = useState(null);
    const [addingMember, setAddingMember] = useState(false);
    const [memberForm, setMemberForm] = useState({ email: '', role: 'member' });
    const [inviteResult, setInviteResult] = useState(null); // { inviteUrl } 开发态回显设密链接
    const [tenantInfo, setTenantInfo] = useState(null); // { tenant, usage, isTenantAdmin }
    const [tenantNameDraft, setTenantNameDraft] = useState('');
    const [deviceDetail, setDeviceDetail] = useState(null); // { device, sessions, assignments }
    const [sessionDetail, setSessionDetail] = useState(null); // { session, events }
    const [devicePolicies, setDevicePolicies] = useState([]);
    const [editingDevicePolicy, setEditingDevicePolicy] = useState(null); // null | {mode:'new'} | {mode:'edit', id}
    const [devicePolicyForm, setDevicePolicyForm] = useState(pmEmptyDevicePolicyForm());
    const [clientBuilds, setClientBuilds] = useState([]);
    const [editingBuild, setEditingBuild] = useState(null); // null | {mode:'new'} | {mode:'edit', id}
    const [buildForm, setBuildForm] = useState(pmEmptyBuildForm());
    const [deployTokenId, setDeployTokenId] = useState('');
    const [tickets, setTickets] = useState([]);
    const [ticketStatusFilter, setTicketStatusFilter] = useState('');
    const [ticketDetail, setTicketDetail] = useState(null); // { ...ticket, comments }
    const [addingTicket, setAddingTicket] = useState(false);
    const [ticketForm, setTicketForm] = useState({ title: '', description: '', priority: 'normal', deviceId: '' });
    const [ticketComment, setTicketComment] = useState('');

    const toast = (severity, message) => setNotify({ open: true, severity, message });

    const loadAll = useCallback(async (options = {}) => {
      const silent = options && options.silent === true;
      if (!silent) setLoading(true);
      if (!silent) setError('');
      try {
        const params = new URLSearchParams();
        if (keyword) params.set('keyword', keyword);
        const noop = (data) => Promise.resolve({ ok: true, status: 200, json: async () => ({ success: true, data }) });
        const resps = await Promise.all([
          fetch(`/management-platform/devices?${params.toString()}`),
          hasDeviceGroups ? fetch('/management-platform/device-groups') : noop([]),
          hasEnrollmentTokens ? fetch('/management-platform/enrollment-tokens') : noop([]),
          fetch('/management-platform/sessions'),
          isTenantAdmin ? fetch('/management-platform/permission-profiles') : noop([]),
          hasAssignments ? fetch('/management-platform/assignments') : noop([]),
          isTenantAdmin ? fetch('/management-platform/users') : noop([]),
          isTenantAdmin ? fetch('/management-platform/audit-logs') : noop([]),
          isTenantAdmin ? fetch('/management-platform/members') : noop([]),
          isTenantAdmin ? fetch('/management-platform/network-overview') : noop(null),
          isTenantAdmin ? fetch('/management-platform/device-policies') : noop([]),
          isTenantAdmin ? fetch('/management-platform/client-builds') : noop([]),
          fetch(`/management-platform/tickets${ticketStatusFilter ? '?status=' + ticketStatusFilter : ''}`)
        ]);
        if (resps.some((resp) => resp.status === 401)) { window.location.href = '/login'; return; }
        const [deviceJson, groupJson, tokenJson, sessionJson, profileJson, assignmentJson, userJson, auditJson, memberJson, networkJson, devicePolicyJson, buildJson, ticketJson] =
          await Promise.all(resps.map((resp) => resp.json()));
        if (!resps[0].ok) throw new Error(deviceJson.message || '加载设备失败');
        setDevices(deviceJson.data || []);
        setGroups(groupJson.data || []);
        setTokens(tokenJson.data || []);
        setSessions(sessionJson.data || []);
        setProfiles(profileJson.data || []);
        setAssignments(assignmentJson.data || []);
        setUsers(userJson.data || []);
        setAuditLogs(auditJson.data || []);
        setMembers(memberJson.data || []);
        setNetworkOverview(networkJson.data || null);
        setDevicePolicies(devicePolicyJson.data || []);
        setClientBuilds(buildJson.data || []);
        setTickets(ticketJson.data || []);
        // 企业设置信息（含配额用量）单独取，避免破坏上面的固定解构。
        try {
          const tResp = await fetch('/management-platform/tenant');
          if (tResp.ok) { const tJson = await tResp.json(); setTenantInfo(tJson.data || null); }
        } catch (e) { /* 忽略：设置页非关键路径 */ }
      } catch (err) {
        if (!silent) setError(err.message || '加载管理数据失败');
      } finally {
        if (!silent) setLoading(false);
      }
    }, [keyword, ticketStatusFilter, isPersonalMode]);

    useEffect(() => { loadAll(); }, [loadAll]);
    useEffect(() => {
      if (!isPersonalMode) return undefined;
      const timer = setInterval(() => { loadAll({ silent: true }); }, 5000);
      return () => clearInterval(timer);
    }, [isPersonalMode, loadAll]);
    useEffect(() => { if (embeddedSection) setSection(embeddedSection); }, [embeddedSection]);
    useEffect(() => { if (tenantInfo && tenantInfo.tenant) setTenantNameDraft(tenantInfo.tenant.name || ''); }, [tenantInfo]);
    useEffect(() => {
      if (!hasDeviceGroups && !hasEnrollmentTokens && deviceTab !== 'list') setDeviceTab('list');
    }, [hasDeviceGroups, hasEnrollmentTokens, deviceTab]);

    const stats = useMemo(() => {
      const online = devices.filter((d) => d.status === 'online').length;
      const active = sessions.filter((s) => s.result === 'active').length;
      const today = sessions.filter((s) => pmIsToday(s.startAt)).length;
      const failed = sessions.filter((s) => s.result === 'failed').length;
      return {
        online, offline: devices.length - online, total: devices.length,
        active, today, grants: assignments.length, groups: groups.length, tokens: tokens.length,
        failRate: sessions.length ? Math.round((failed / sessions.length) * 100) : 0
      };
    }, [devices, sessions, assignments, groups, tokens]);

    const visibleDevices = useMemo(() =>
      devices.filter((d) => statusFilter === 'all' ? true : d.status === statusFilter),
    [devices, statusFilter]);

    // ---------- handlers ----------
    const openEditDevice = (device) => {
      setEditingDevice(device);
      setDeviceForm({
        alias: device.alias || '', groupId: device.groupId || '', policyId: device.policyId || '',
        tags: (device.tags || []).join(','), unattended: !!device.unattended, enabled: device.enabled !== false
      });
    };
    const saveDevice = async () => {
      if (!editingDevice) return;
      try {
        const resp = await fetch(`/management-platform/devices/${editingDevice.id}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            alias: deviceForm.alias, groupId: deviceForm.groupId || null, policyId: deviceForm.policyId || null,
            tags: deviceForm.tags.split(',').map((item) => item.trim()).filter(Boolean),
            unattended: deviceForm.unattended, enabled: deviceForm.enabled
          })
        });
        const result = await resp.json();
        if (!resp.ok) throw new Error(result.message || '保存设备失败');
        toast('success', '设备已保存'); setEditingDevice(null); await loadAll();
      } catch (err) { toast('error', err.message || '保存设备失败'); }
    };
    const createGroup = async () => {
      const name = groupName.trim();
      if (!name) return;
      try {
        const resp = await fetch('/management-platform/device-groups', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name })
        });
        const result = await resp.json();
        if (!resp.ok) throw new Error(result.message || '创建设备组失败');
        setGroupName(''); toast('success', '设备组已创建'); await loadAll();
      } catch (err) { toast('error', err.message || '创建设备组失败'); }
    };
    const createToken = async () => {
      try {
        const resp = await fetch('/management-platform/enrollment-tokens', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ groupId: tokenForm.groupId || null, maxUses: Number(tokenForm.maxUses || 0), expiresAt: tokenForm.expiresAt || null })
        });
        const result = await resp.json();
        if (!resp.ok) throw new Error(result.message || '创建注册令牌失败');
        toast('success', '注册令牌已创建'); await loadAll();
      } catch (err) { toast('error', err.message || '创建注册令牌失败'); }
    };
    const revokeToken = async (tokenId) => {
      try {
        const resp = await fetch(`/management-platform/enrollment-tokens/${tokenId}`, { method: 'DELETE' });
        const result = await resp.json();
        if (!resp.ok) throw new Error(result.message || '停用注册令牌失败');
        toast('success', '注册令牌已停用'); await loadAll();
      } catch (err) { toast('error', err.message || '停用注册令牌失败'); }
    };
    const copyToken = (value) => {
      try { navigator.clipboard.writeText(value); toast('success', '令牌已复制'); }
      catch (e) { toast('warning', '复制失败，请手动选择'); }
    };
    const createAssignment = async () => {
      if (!assignmentForm.subjectId || !assignmentForm.targetId) { toast('warning', '请选择授权主体和目标'); return; }
      try {
        const resp = await fetch('/management-platform/assignments', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            subjectType: assignmentForm.subjectType, subjectId: assignmentForm.subjectId,
            targetType: assignmentForm.targetType, targetId: assignmentForm.targetId,
            profileId: assignmentForm.profileId || null, startDate: assignmentForm.startDate || null,
            endDate: assignmentForm.endDate || null, allowedCidr: assignmentForm.allowedCidr || null
          })
        });
        const result = await resp.json();
        if (!resp.ok) throw new Error(result.message || '创建授权失败');
        toast('success', '授权已创建'); await loadAll();
      } catch (err) { toast('error', err.message || '创建授权失败'); }
    };
    const revokeAssignment = async (assignmentId) => {
      try {
        const resp = await fetch(`/management-platform/assignments/${assignmentId}`, { method: 'DELETE' });
        const result = await resp.json();
        if (!resp.ok) throw new Error(result.message || '撤销授权失败');
        toast('success', '授权已撤销'); await loadAll();
      } catch (err) { toast('error', err.message || '撤销授权失败'); }
    };

    const openNewProfile = () => { setProfileForm(pmEmptyProfileForm()); setEditingProfile({ mode: 'new' }); };
    const openEditProfile = (p) => {
      setProfileForm({
        name: p.name || '', controlInput: !!p.controlInput, fileTransfer: !!p.fileTransfer,
        clipboard: !!p.clipboard, audio: !!p.audio, multiMonitor: !!p.multiMonitor, gamepad: !!p.gamepad,
        remoteReboot: !!p.remoteReboot, privacyScreen: !!p.privacyScreen, recordSession: !!p.recordSession,
