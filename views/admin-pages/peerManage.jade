              PM_H(MaterialUI.Box, { sx: { display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 1.5 } },
                PM_H(MaterialUI.TextField, { select: true, label: '优先级', value: ticketForm.priority, onChange: (e) => setTicketForm((p) => ({ ...p, priority: e.target.value })) },
                  ['low', 'normal', 'high', 'urgent'].map((pr) => PM_H(MaterialUI.MenuItem, { key: pr, value: pr }, PM_TICKET_PRIORITY[pr]))
                ),
                PM_H(MaterialUI.TextField, { select: true, label: '关联设备（可选）', value: ticketForm.deviceId, onChange: (e) => setTicketForm((p) => ({ ...p, deviceId: e.target.value })) },
                  PM_H(MaterialUI.MenuItem, { value: '' }, '不关联'),
                  devices.map((d) => PM_H(MaterialUI.MenuItem, { key: d.id, value: d.id }, d.alias || d.hostname || d.terminalId))
                )
              )
            )
          ),
          PM_H(MaterialUI.DialogActions, { sx: { px: 3, pb: 2 } },
            PM_H(MaterialUI.Button, { onClick: () => setAddingTicket(false) }, '取消'),
            PM_H(MaterialUI.Button, { variant: 'contained', onClick: submitTicket }, '创建')
          )
        ),
        PM_H(MaterialUI.Drawer, { anchor: 'right', open: !!ticketDetail, onClose: () => setTicketDetail(null), PaperProps: { sx: { width: { xs: '100%', sm: 480 }, p: 3 } } },
          ticketDetail ? (function () {
            const t = ticketDetail;
            return PM_H(MaterialUI.Box, { sx: { display: 'flex', flexDirection: 'column', height: '100%' } },
              PM_H(MaterialUI.Stack, { direction: 'row', spacing: 1, alignItems: 'flex-start', sx: { mb: 2 } },
                PM_H(MaterialUI.Box, { sx: { flex: 1, minWidth: 0 } },
                  PM_H(MaterialUI.Typography, { sx: { fontWeight: 700, color: '#101828' } }, t.title),
                  PM_H(MaterialUI.Typography, { variant: 'caption', sx: { color: '#98a2b3' } }, '报修：' + (t.requesterName || t.requesterId || '-') + ' · ' + pmFormatDate(t.createdAt))
                ),
                PM_H(MaterialUI.IconButton, { size: 'small', onClick: () => setTicketDetail(null) }, pmIcon('close'))
              ),
              PM_H(MaterialUI.Box, { sx: { display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 1.5, mb: 2 } },
                PM_H(MaterialUI.TextField, { select: true, size: 'small', label: '状态', value: t.status, onChange: (e) => patchTicket(t.id, { status: e.target.value }) },
                  ['open', 'in_progress', 'resolved', 'closed'].map((st) => PM_H(MaterialUI.MenuItem, { key: st, value: st }, PM_TICKET_STATUS[st]))
                ),
                PM_H(MaterialUI.TextField, { select: true, size: 'small', label: '优先级', value: t.priority, onChange: (e) => patchTicket(t.id, { priority: e.target.value }) },
                  ['low', 'normal', 'high', 'urgent'].map((pr) => PM_H(MaterialUI.MenuItem, { key: pr, value: pr }, PM_TICKET_PRIORITY[pr]))
                ),
                PM_H(MaterialUI.TextField, { select: true, size: 'small', label: '处理人', value: t.assigneeId || '', onChange: (e) => patchTicket(t.id, { assigneeId: e.target.value }), sx: { gridColumn: '1 / span 2' } },
                  PM_H(MaterialUI.MenuItem, { value: '' }, '未指派'),
                  members.map((m) => PM_H(MaterialUI.MenuItem, { key: m.id, value: m.userId }, (m.label || m.userId) + '（' + (({ owner: '所有者', admin: '管理员', technician: '技术员', auditor: '审计员', member: '成员' })[m.role] || m.role) + '）'))
                )
              ),
              t.deviceName ? PM_H(MaterialUI.Chip, { size: 'small', variant: 'outlined', icon: pmIcon('computer'), label: '关联设备：' + t.deviceName, sx: { mb: 2, alignSelf: 'flex-start' } }) : null,
              t.description ? PM_H(MaterialUI.Box, { sx: { bgcolor: '#fafbfc', borderRadius: 2, p: 1.5, mb: 2 } }, PM_H(MaterialUI.Typography, { variant: 'body2', sx: { color: '#344054', whiteSpace: 'pre-wrap' } }, t.description)) : null,
              PM_H(MaterialUI.Divider, { sx: { mb: 1.5 } }),
              PM_H(MaterialUI.Typography, { sx: { fontWeight: 700, mb: 1 } }, '沟通记录'),
              PM_H(MaterialUI.Box, { sx: { flex: 1, overflowY: 'auto', mb: 1.5 } },
                (t.comments && t.comments.length)
                  ? PM_H(MaterialUI.Stack, { spacing: 1.25 }, t.comments.map((c) =>
                      PM_H(MaterialUI.Box, { key: c.id, sx: { bgcolor: '#f6f7fb', borderRadius: 2, p: 1.25 } },
                        PM_H(MaterialUI.Stack, { direction: 'row', justifyContent: 'space-between', sx: { mb: 0.5 } },
                          PM_H(MaterialUI.Typography, { variant: 'caption', sx: { fontWeight: 700, color: '#475467' } }, c.authorName || c.authorId || '系统'),
                          PM_H(MaterialUI.Typography, { variant: 'caption', sx: { color: '#98a2b3' } }, pmTimeAgo(c.createdAt))
                        ),
                        PM_H(MaterialUI.Typography, { variant: 'body2', sx: { color: '#344054', whiteSpace: 'pre-wrap' } }, c.body)
                      )
                    ))
                  : PM_H(MaterialUI.Typography, { variant: 'body2', sx: { color: '#98a2b3' } }, t.loading ? '加载中…' : '暂无沟通记录')
              ),
              PM_H(MaterialUI.Stack, { direction: 'row', spacing: 1, alignItems: 'flex-end' },
                PM_H(MaterialUI.TextField, { size: 'small', fullWidth: true, placeholder: '添加沟通记录…', value: ticketComment, onChange: (e) => setTicketComment(e.target.value), multiline: true, maxRows: 4, onKeyDown: (e) => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) submitTicketComment(); } }),
                PM_H(MaterialUI.Button, { variant: 'contained', onClick: submitTicketComment }, '发送')
              )
            );
          })() : null
        ),
        PM_H(MaterialUI.Snackbar, { open: notify.open, autoHideDuration: 3000, onClose: () => setNotify((p) => ({ ...p, open: false })), anchorOrigin: { vertical: 'bottom', horizontal: 'center' } },
          PM_H(MaterialUI.Alert, { severity: notify.severity, onClose: () => setNotify((p) => ({ ...p, open: false })), variant: 'filled', sx: { width: '100%' } }, notify.message)
        )
    );

    if (embedded) return contentColumn;
    return PM_H(MaterialUI.Box, { sx: { display: 'flex', gap: 2.5, alignItems: 'flex-start' } }, renderSidebar(), contentColumn);
  };
