#!/usr/bin/env node

/**
 * Load environment variables from pweb/.env (if present) before anything else,
 * so settings like RELAY_PUBLIC_HOST / RELAY_UDP_PORT / PORT can live in .env.
 */
try { require('dotenv').config(); } catch (e) { /* dotenv optional */ }

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('pweb:server');
var http = require('http');
var { buildSocketServer } = require('../services/realtime/socket_server');
var { RelayServer } = require('../services/realtime/relay_server');
// relay 池纳管：relay_registry 自启健康检查（见 relay_registry.js 单例）。
// 旧单机 RelayServer 仅作开发回退，POLEIS_RELAY_ENABLED=1 时启动。
var { relayRegistry } = require('../services/realtime/relay_registry');
// 主动 STUN 探测：周期向各 coturn 节点发 STUN Binding，自动维持 online/offline + 延迟。
var { RelayStunProber } = require('../services/realtime/relay_stun_prober');
var relayStunProber = new RelayStunProber(relayRegistry);
relayStunProber.start();

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

// Relay 池由 relay_registry 纳管（Prisma + Redis），无需本地进程。
// 旧单机 RelayServer 仅开发回退：POLEIS_RELAY_ENABLED=1 时启动，用于
// 没有独立 coturn 节点的本地测试环境。
var relayEnabled = /^(1|true|yes|on)$/i.test(process.env.POLEIS_RELAY_ENABLED || '');
var relay = null;
if (relayEnabled) {
  relay = new RelayServer();
  relay.start();
  console.log('[relay] legacy local RelayServer started (dev fallback)');
} else {
  console.log('[relay] pool-managed (registry); legacy local relay disabled');
}
buildSocketServer(server, { relay });

/**
 * Listen on provided port, on all network interfaces.
 */
var host = process.env.HOST || '0.0.0.0';
server.listen(port, host);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
