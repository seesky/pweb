NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://control.example.com
ALLOWED_ORIGINS=https://control.example.com
TRUST_PROXY=true

# Generate independent values with at least 32 random characters.
COOKIE_SECRET=replace-with-a-unique-random-secret
SESSION_SECRET=replace-with-a-different-random-secret
AUTH_JWT_SECRET=replace-with-a-different-random-secret
SOCKET_JWT_SECRET=replace-with-a-different-random-secret

# Dedicated Redis database for server-side web sessions.
SESSION_REDIS_URL=redis://127.0.0.1:6379/1

# Existing application services.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/poleis
REDIS_URL=redis://127.0.0.1:6379/0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=poleis
DB_PASSWORD=replace-with-database-password
DB_NAME=poleis

# Optional UDP relay. Expose RELAY_UDP_PORT/udp only when this is enabled.
POLEIS_RELAY_ENABLED=false
RELAY_PUBLIC_HOST=
RELAY_UDP_PORT=3479

# Set only while running `npm run security:reset-admin`, then remove it.
# ADMIN_BOOTSTRAP_PASSWORD=
