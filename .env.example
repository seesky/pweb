NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://control.example.com
ALLOWED_ORIGINS=https://control.example.com
TRUST_PROXY=true

# Generate independent values with at least 32 random characters.
COOKIE_SECRET=replace-with-a-unique-random-secret
SESSION_SECRET=replace-with-a-different-random-secret
AUTH_JWT_SECRET=replace-with-a-different-random-secret
SOCKET_JWT_SECRET=replace-with-a-different-random-secret

# ---- Login throttling & lockout ----
# All values are optional; defaults match the previous hardcoded behavior.
# 2FA 临时凭证有效期（秒），默认 300（5 分钟）。
# AUTH_TEMP_TOKEN_TTL_SECONDS=300
# 密码连续失败多少次后锁定账户，默认 5；设为 0 则不按次数锁定（但仍受下方开关控制）。
# AUTH_MAX_PASSWORD_FAILURES=5
# 达到失败阈值后的锁定时长（分钟），默认 30。
# AUTH_LOCK_MINUTES=30
# 是否启用「密码失败锁定」功能，默认 true；设为 false 则既不校验已有锁定、也不新增锁定。
# AUTH_PASSWORD_LOCK_ENABLED=true
# 是否启用登录接口限流（/login POST、/auth/login、/auth/2fa/verify、/auth/password/*），默认 true。
# AUTH_RATE_LIMIT_ENABLED=true
# 限流计数窗口（毫秒），默认 900000（15 分钟）。
# AUTH_RATE_WINDOW_MS=900000
# 窗口内同一 IP 的最大请求次数，默认 10。
# AUTH_RATE_LIMIT=10
# 会话 cookie 有效期（毫秒），默认 14400000（4 小时）。
# SESSION_COOKIE_MAX_AGE_MS=14400000

# Dedicated Redis database for server-side web sessions.
SESSION_REDIS_URL=redis://127.0.0.1:6379/1

# Existing application services.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/poleis
REDIS_URL=redis://127.0.0.1:6379/0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=poleis
DB_PASSWORD=replace-with-database-password
DB_NAME=poleis

# Optional UDP relay. Expose RELAY_UDP_PORT/udp only when this is enabled.
POLEIS_RELAY_ENABLED=false
RELAY_PUBLIC_HOST=
RELAY_UDP_PORT=3479

# Set only while running `npm run security:reset-admin`, then remove it.
# ADMIN_BOOTSTRAP_PASSWORD=
