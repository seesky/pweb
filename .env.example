DATABASE_URL="mysql://root:123456@127.0.0.1:3306/poleis_web"

# Optional split settings used by some utilities.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=poleis_web

PORT=3000
SESSION_SECRET=change-me
COOKIE_SECRET=change-me

# Optional shared presence storage. Without this, realtime presence is kept
# in memory and is suitable for a single Node.js server process.
# REDIS_URL=redis://127.0.0.1:6379

# Parsec-style UDP relay (TURN-like fallback). Disabled by default so Poleis
# only attempts direct P2P. Set this explicitly to true to enable the relay.
POLEIS_RELAY_ENABLED=false
#
# RELAY_PUBLIC_HOST is the PUBLIC IP/domain clients & agents send relay UDP to;
# it is advertised to the peers as the relay endpoint. It must be reachable from
# the peers — do NOT use 0.0.0.0 / :: here (those are listen wildcards, not a
# routable destination). Leave it empty to auto-use the address the client
# connected to (the socket.io request Host). The relay always LISTENS on
# 0.0.0.0:RELAY_UDP_PORT regardless. Open RELAY_UDP_PORT/udp in the firewall.
RELAY_PUBLIC_HOST=
RELAY_UDP_PORT=3479
